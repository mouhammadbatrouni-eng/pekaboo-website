---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FeatureIcon from "../components/ui/FeatureIcon.astro";
import Button from "../components/ui/Button.astro";
import PortalScreen from "../components/product/PortalScreen.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { Check, ArrowRight } from "@lucide/astro";
import { MODULE_CATEGORIES } from "../lib/content/modules";
import { SITE } from "../lib/content/site";

export const prerender = true;

/** A day in the setting, in the order it actually happens. */
const DAY_FLOW = [
  {
    time: "07:30",
    title: "Doors open",
    description:
      "Children are marked present as they arrive, with late arrivals and excused absences recorded. The dashboard updates as it happens.",
    screen: "attendance" as const,
  },
  {
    time: "10:00",
    title: "In the room",
    description:
      "Educators log observations against your curriculum objectives, and note next steps while the moment is still fresh.",
    screen: "observation" as const,
  },
  {
    time: "15:30",
    title: "Wrapping up",
    description:
      "Daily reports are drafted per child — meals, nap, mood, hygiene — then published to families in one action.",
    screen: "dailyReport" as const,
  },
  {
    time: "Month end",
    title: "The office side",
    description:
      "Invoices are built from your defined services with VAT applied, and expenses and supplier payments sit in the same ledger.",
    screen: "invoice" as const,
  },
];

const ROLES = [
  {
    role: "Educators",
    gains: ["Attendance and daily reports in one place", "Observations linked to objectives", "No evening paperwork"],
    icon: "curriculum",
  },
  {
    role: "Managers",
    gains: ["Live occupancy and ratios", "Health alerts and incidents", "Staff and class assignment"],
    icon: "attendance",
  },
  {
    role: "Finance",
    gains: ["Invoices, receipts and payment modes", "Expenses, suppliers and purchases", "A single monthly picture"],
    icon: "finance",
  },
  {
    role: "Owners",
    gains: ["Multi-center visibility", "Admissions pipeline", "Role-based access control"],
    icon: "people",
  },
];
---

<PageLayout
  title={SITE.products.care}
  seo={{
    metaTitle: `${SITE.products.care} — the portal your nursery team runs on`,
    metaDescription:
      "Peekaboo Care is the web portal for nursery teams: attendance, daily reports, curriculum and assessment, health and safety, staff, finance and admissions in one system.",
  }}
>
  <PageHeader
    eyebrow={SITE.products.care}
    heading="The portal your team runs the setting from"
    intro="One place for the operation — attendance and ratios, curriculum and observations, health records, staff, invoicing and admissions. Built for the people doing the work, not just the people reporting on it."
  />

  <Container class="pb-16">
    <div class="mx-auto max-w-4xl">
      <PortalScreen screen="dashboard" />
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/contact" size="lg">Book a demo</Button>
      <Button href="/features" variant="secondary" size="lg">See every capability</Button>
    </div>
  </Container>

  <Section surface="tint" labelledBy="day-heading">
    <Container>
      <SectionHeading
        id="day-heading"
        eyebrow="A day on Peekaboo Care"
        title="Follow it through a working day"
        description="The same record, carried from the front door to the finance office — entered once."
      />

      <div class="mt-16 space-y-16 lg:space-y-24">
        {DAY_FLOW.map((step, index) => (
          <div
            class:list={[
              "grid items-center gap-10 lg:grid-cols-2 lg:gap-16",
              index % 2 === 1 && "lg:[&>*:first-child]:order-2",
            ]}
          >
            <div>
              <span class="inline-flex items-center rounded-full bg-brand-50 px-3.5 py-1.5 font-heading text-lg tracking-[-0.02em] text-brand-700">
                {step.time}
              </span>
              <h3 class="mt-4 font-heading text-2xl tracking-[-0.03em] text-ink-900">{step.title}</h3>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-500">{step.description}</p>
            </div>
            <PortalScreen screen={step.screen} />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section labelledBy="roles-heading">
    <Container>
      <SectionHeading id="roles-heading" eyebrow="Built for the whole team" title="What each role gets out of it" />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ROLES.map((role) => (
          <article class="rounded-xl border border-ink-100 bg-white/90 p-6 shadow-soft">
            <FeatureIcon icon={role.icon} class="h-11 w-11" />
            <h3 class="mt-5 font-heading text-lg tracking-[-0.02em] text-ink-900">{role.role}</h3>
            <ul class="mt-3 space-y-2">
              {role.gains.map((gain) => (
                <li class="flex items-start gap-2 text-sm leading-relaxed text-ink-500">
                  <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
                    <Check size={10} stroke-width={3.5} aria-hidden="true" />
                  </span>
                  {gain}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section surface="tint" labelledBy="areas-heading">
    <Container>
      <SectionHeading id="areas-heading" eyebrow="Everything inside" title="The seven areas of the platform" />
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {MODULE_CATEGORIES.map((category) => (
          <a
            href={`/features#${category.id}`}
            class="group flex items-start gap-4 rounded-xl border border-ink-100 bg-white p-5 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft-lg"
          >
            <FeatureIcon icon={category.icon} tone={category.tone} class="h-10 w-10" />
            <span class="min-w-0">
              <span class="flex items-center gap-1.5 font-bold text-ink-900">
                {category.title}
                <ArrowRight
                  size={14}
                  class="text-brand-500 transition-transform duration-200 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-400">{category.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </Section>

  <FinalCta
    heading={`See ${SITE.products.care} with your rooms in it`}
    description="We'll set up a walkthrough using your classes, age groups and fee structure."
  />
</PageLayout>
