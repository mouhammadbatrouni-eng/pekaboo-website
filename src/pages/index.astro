---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Sections from "../components/sections/Sections.astro";
import { getHomePage } from "../lib/sanity/queries";

export const prerender = true;

const homePage = await getHomePage();
---

<PageLayout title="Home" seo={homePage.seo} includeOrgSchema>
  <Hero
    eyebrow={homePage.heroEyebrow}
    heading={homePage.heroHeading}
    description={homePage.heroDescription}
    ctas={homePage.heroCtas}
  />
  <Sections sections={homePage.sections} />
</PageLayout>
