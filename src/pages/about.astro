---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FeatureIcon from "../components/ui/FeatureIcon.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { PortableText } from "astro-portabletext";
import { Mail, Phone, MapPin } from "@lucide/astro";
import { getPage } from "../lib/sanity/queries";
import { SITE } from "../lib/content/site";

export const prerender = true;

const page = await getPage("about");
if (!page) return Astro.redirect("/404");

const PRINCIPLES = [
  {
    title: "Built with settings, not at them",
    description:
      "The platform's shape — classes, age groups, attainment levels, daily-report sections — comes from how nurseries told us they work, which is why so much of it is configurable rather than fixed.",
    icon: "people",
  },
  {
    title: "Enter it once",
    description:
      "If your team has already recorded something, no one should have to type it again for a parent, a report or an invoice. That principle decides most of what we build.",
    icon: "attendance",
  },
  {
    title: "Children's data deserves care",
    description:
      "Allergies, medical notes and family details are among the most sensitive records a business can hold. Encrypted storage, scheduled backups and role-based access are baseline, not upsells.",
    icon: "security",
  },
];
---

<PageLayout title={page.title} seo={page.seo}>
  <PageHeader eyebrow={page.eyebrow} heading={page.heading} intro={page.intro} />

  {page.body && (
    <Container class="max-w-3xl pb-12">
      <div class="prose max-w-none prose-headings:font-heading prose-headings:tracking-[-0.03em]">
        <PortableText value={page.body} />
      </div>
    </Container>
  )}

  <Section surface="tint" labelledBy="principles-heading">
    <Container>
      <SectionHeading id="principles-heading" eyebrow="How we build" title="What we hold to" />
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {PRINCIPLES.map((principle) => (
          <article class="rounded-xl border border-ink-100 bg-white p-7 shadow-soft">
            <FeatureIcon icon={principle.icon} class="h-11 w-11" />
            <h3 class="mt-5 font-heading text-lg tracking-[-0.02em] text-ink-900">{principle.title}</h3>
            <p class="mt-2.5 leading-relaxed text-ink-500">{principle.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section labelledBy="contact-details-heading">
    <Container class="max-w-3xl">
      <SectionHeading
        id="contact-details-heading"
        eyebrow="Find us"
        title="Talk to a person"
        description={`Peekaboo is built and supported by ${SITE.parentCompany}.`}
      />

      <dl class="mt-12 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-ink-100 bg-white p-6 text-center shadow-soft">
          <dt class="flex justify-center">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <Phone size={17} aria-hidden="true" />
            </span>
            <span class="sr-only">Phone</span>
          </dt>
          <dd class="mt-3">
            <a href={SITE.phoneHref} class="font-semibold text-ink-900 transition-colors hover:text-brand-700">
              {SITE.phone}
            </a>
          </dd>
        </div>
        <div class="rounded-xl border border-ink-100 bg-white p-6 text-center shadow-soft">
          <dt class="flex justify-center">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <Mail size={17} aria-hidden="true" />
            </span>
            <span class="sr-only">Email</span>
          </dt>
          <dd class="mt-3">
            <a
              href={`mailto:${SITE.email}`}
              class="break-all font-semibold text-ink-900 transition-colors hover:text-brand-700"
            >
              {SITE.email}
            </a>
          </dd>
        </div>
        <div class="rounded-xl border border-ink-100 bg-white p-6 text-center shadow-soft">
          <dt class="flex justify-center">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <MapPin size={17} aria-hidden="true" />
            </span>
            <span class="sr-only">Office</span>
          </dt>
          <dd class="mt-3 font-semibold text-ink-900">{SITE.location}</dd>
        </div>
      </dl>
    </Container>
  </Section>

  <FinalCta />
</PageLayout>
