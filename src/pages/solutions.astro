---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Solutions from "../components/sections/Solutions.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { Check, Minus } from "@lucide/astro";
import { SOLUTIONS } from "../lib/content/solutions";

export const prerender = true;

/** Comparison across the three adoption models. */
const COMPARISON = [
  { feature: "Peekaboo Care portal", values: [true, true, true] },
  { feature: "Parent mobile app", values: [true, true, true] },
  { feature: "Your branding on the parent app", values: [false, true, true] },
  { feature: "Published under your organisation", values: [false, true, true] },
  { feature: "Modules configured to your setup", values: [true, true, true] },
  { feature: "Custom modules built to your process", values: [false, false, true] },
  { feature: "Custom management system", values: [false, false, true] },
  { feature: "Fastest to launch", values: [true, false, false] },
];

const AUDIENCES = [
  {
    title: "Single nurseries",
    description:
      "One setting, one team, and no appetite for a six-month implementation. Start on the platform as it comes and configure the modules you need.",
  },
  {
    title: "Nursery groups",
    description:
      "Several centers under one organisation, each with its own licence, currency and timezone — managed together, reported on together.",
  },
  {
    title: "Established brands",
    description:
      "Families already recognise your name. Put the parent app in your own branding while Peekaboo Care runs the operation behind it.",
  },
  {
    title: "Organisations with their own process",
    description:
      "Workflows that don't fit an off-the-shelf platform. Have the system and app designed around how you actually operate.",
  },
];
---

<PageLayout
  title="Solutions"
  seo={{
    metaTitle: "Solutions — three ways to adopt Peekaboo",
    metaDescription:
      "Use Peekaboo as it comes, publish the parent app under your own branding, or have a system built around your operation. Compare the three adoption models.",
  }}
>
  <PageHeader
    eyebrow="Solutions"
    heading="Three ways to make Peekaboo yours"
    intro="Every setting arrives with a different starting point. These are the three ways organisations adopt the platform — and what changes between them."
  />

  <Solutions bare surface="plain" />

  <Section surface="tint" labelledBy="comparison-heading">
    <Container class="max-w-4xl">
      <SectionHeading
        id="comparison-heading"
        eyebrow="Side by side"
        title="What changes between them"
      />

      <div class="mt-12 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-left">
          <caption class="sr-only">
            Comparison of the three Peekaboo adoption models across included capabilities
          </caption>
          <thead>
            <tr class="border-b border-ink-200">
              <th scope="col" class="pb-4 pr-4 text-sm font-bold text-ink-900">Included</th>
              {SOLUTIONS.map((solution) => (
                <th scope="col" class="px-3 pb-4 text-center text-sm font-bold text-ink-900">
                  {solution.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {COMPARISON.map((row) => (
              <tr class="border-b border-ink-100">
                <th scope="row" class="py-3.5 pr-4 text-sm font-medium text-ink-700">{row.feature}</th>
                {row.values.map((value, i) => (
                  <td class="px-3 py-3.5 text-center">
                    {value ? (
                      <>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-mint-soft text-success">
                          <Check size={13} stroke-width={3} aria-hidden="true" />
                        </span>
                        <span class="sr-only">Included in {SOLUTIONS[i].name}</span>
                      </>
                    ) : (
                      <>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-ink-100 text-ink-300">
                          <Minus size={13} stroke-width={3} aria-hidden="true" />
                        </span>
                        <span class="sr-only">Not included in {SOLUTIONS[i].name}</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Section>

  <Section labelledBy="audiences-heading">
    <Container>
      <SectionHeading
        id="audiences-heading"
        eyebrow="Who it's for"
        title="Where each one usually lands"
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {AUDIENCES.map((audience) => (
          <article class="rounded-xl border border-ink-100 bg-white/90 p-7 shadow-soft">
            <h3 class="font-heading text-lg tracking-[-0.02em] text-ink-900">{audience.title}</h3>
            <p class="mt-2.5 leading-relaxed text-ink-500">{audience.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <FinalCta
    heading="Let's work out which one fits"
    description="Tell us how your setting runs today and we'll recommend the shortest route to getting it on Peekaboo."
  />
</PageLayout>
