---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FeatureIcon from "../components/ui/FeatureIcon.astro";
import Button from "../components/ui/Button.astro";
import ParentAppScreen from "../components/product/ParentAppScreen.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { Check } from "@lucide/astro";
import { SITE } from "../lib/content/site";
import { LANGUAGES } from "../lib/content/marketing";

export const prerender = true;

const PARENT_FEATURES = [
  {
    title: "The daily report",
    description:
      "What they ate, how they slept, how the day felt — published by the room, not summarised at the door.",
    icon: "communication",
  },
  {
    title: "Moments & media",
    description:
      "Photos and video from the day, shared only with families who have given permission for them.",
    icon: "timeline",
  },
  {
    title: "Announcements & newsletters",
    description:
      "Nursery updates reach the right classes, so parents aren't relying on a note in a bag.",
    icon: "curriculum",
  },
  {
    title: "Events & calendar",
    description:
      "Holidays, trips and performances land in a shared calendar families can plan around.",
    icon: "calendar",
  },
  {
    title: "Their child's profile",
    description:
      "Contact details, allergies, medical notes and authorised pickups — kept current by the people who know.",
    icon: "people",
  },
  {
    title: "Fees & receipts",
    description:
      "Invoices and receipts in the same place as everything else, instead of a separate email thread.",
    icon: "finance",
  },
];

const STAFF_BENEFITS = [
  "Nothing is written twice — the report the room drafts is the one parents read",
  "Photo permissions are respected automatically, per child",
  "Fewer phone calls to the office asking how the day went",
  "Announcements reach every family without a paper chase",
];
---

<PageLayout
  title={SITE.products.parent}
  seo={{
    metaTitle: `${SITE.products.parent} — the app families follow their child's day in`,
    metaDescription:
      "Peekaboo Parent gives families daily reports, photos, announcements and events as they're published by the nursery. Available in English and Arabic with full right-to-left support.",
  }}
>
  <PageHeader
    eyebrow={SITE.products.parent}
    heading="Families see the day, not just the pickup"
    intro="The mobile side of Peekaboo. Parents follow their child's day as the room publishes it — and your team doesn't write anything twice to make that happen."
  />

  <Container class="pb-16">
    <div class="flex flex-wrap items-end justify-center gap-6 sm:gap-10">
      <ParentAppScreen class="max-w-[240px]" />
      <ParentAppScreen screen="dailyReport" class="max-w-[240px]" />
      <ParentAppScreen rtl class="hidden max-w-[240px] lg:block" />
    </div>
    <div class="mt-12 flex flex-wrap justify-center gap-3">
      <Button href="/contact" size="lg">Book a demo</Button>
      <Button href="/peekaboo-care" variant="secondary" size="lg">See the staff portal</Button>
    </div>
  </Container>

  <Section surface="tint" labelledBy="parent-features-heading">
    <Container>
      <SectionHeading
        id="parent-features-heading"
        eyebrow="What parents get"
        title="Everything about their child, in one app"
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PARENT_FEATURES.map((feature) => (
          <article class="rounded-xl border border-ink-100 bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft-lg">
            <FeatureIcon icon={feature.icon} class="h-11 w-11" />
            <h3 class="mt-5 font-heading text-lg tracking-[-0.02em] text-ink-900">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{feature.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section labelledBy="languages-heading">
    <Container>
      <div class="grid items-center gap-14 lg:grid-cols-[1fr_auto]">
        <div class="max-w-xl">
          <SectionHeading
            id="languages-heading"
            align="left"
            eyebrow="Built for mixed communities"
            title="English and Arabic, properly"
          />
          <p class="mt-4 text-lg leading-relaxed text-ink-500">{LANGUAGES.note}</p>
          <p class="mt-4 leading-relaxed text-ink-500">
            Right-to-left isn't a translation layer bolted on top — the whole interface mirrors,
            so Arabic-speaking families get an app that reads the way they read.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {LANGUAGES.supported.map((language) => (
              <li class="rounded-full border border-ink-100 bg-white px-4 py-2 font-semibold text-ink-700 shadow-soft">
                <span lang={language.dir === "rtl" ? "ar" : "en"} dir={language.dir}>{language.native}</span>
                <span class="ml-2 text-sm font-normal text-ink-400">{language.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex justify-center gap-5">
          <ParentAppScreen class="max-w-[215px]" />
          <ParentAppScreen rtl class="hidden max-w-[215px] sm:block" />
        </div>
      </div>
    </Container>
  </Section>

  <Section surface="tint" labelledBy="staff-benefit-heading">
    <Container class="max-w-3xl text-center">
      <SectionHeading
        id="staff-benefit-heading"
        eyebrow="And for your team"
        title="Parent engagement without extra work"
        description="The usual trade-off with parent apps is that someone has to feed them. Peekaboo doesn't work that way — the app is fed by the records your team already keeps."
      />
      <ul class="mx-auto mt-10 grid max-w-xl gap-3 text-left">
        {STAFF_BENEFITS.map((benefit) => (
          <li class="flex items-start gap-3 rounded-xl border border-ink-100 bg-white p-4 text-sm leading-relaxed text-ink-700 shadow-soft">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
              <Check size={11} stroke-width={3} aria-hidden="true" />
            </span>
            {benefit}
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <FinalCta
    heading="Show your families what they've been missing"
    description="Book a walkthrough and we'll show you both sides — what your team enters, and what parents see."
  />
</PageLayout>
