---
import Container from "../ui/Container.astro";
import { TRUST_POINTS } from "../../lib/content/marketing";
---

<div class="border-y border-ink-100 bg-white/60">
  <Container class="py-8">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {TRUST_POINTS.map((point) => (
        <li class="flex flex-col gap-1">
          <span class="text-sm font-bold text-ink-900">{point.label}</span>
          <span class="text-sm leading-snug text-ink-400">{point.detail}</span>
        </li>
      ))}
    </ul>
  </Container>
</div>
