---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { CTA, SITE } from "../../lib/content/site";
import { Mail, Phone } from "@lucide/astro";

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "See what running your nursery on Peekaboo feels like",
  description = "A short walkthrough with our team, using your rooms, your age groups and your fees — so you can judge it against how you actually work.",
} = Astro.props;
---

<section class="py-20 sm:py-28">
  <Container>
    <div class="relative overflow-hidden rounded-2xl bg-ink-950 px-7 py-16 text-center sm:px-16">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_80%_at_50%_0%,var(--color-brand-700),transparent)] opacity-70"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <h2 class="mx-auto max-w-2xl text-3xl text-white sm:text-4xl">{heading}</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-ink-300">{description}</p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <Button href={CTA.primary.href} size="lg">{CTA.primary.label}</Button>
          <Button
            href={CTA.secondary.href}
            variant="secondary"
            size="lg"
            class="!border-white/15 !bg-white/5 !text-white hover:!bg-white/10 hover:!text-white"
          >
            {CTA.secondary.label}
          </Button>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-ink-400">
          <a href={SITE.phoneHref} class="inline-flex items-center gap-2 transition-colors hover:text-white">
            <Phone size={15} aria-hidden="true" />
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 transition-colors hover:text-white">
            <Mail size={15} aria-hidden="true" />
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
