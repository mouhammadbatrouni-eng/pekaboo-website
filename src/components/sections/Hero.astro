---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import { resolveLink } from "../../lib/content/resolveLink";
import type { Cta } from "../../lib/content/types";

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  ctas?: Cta[];
}

const { eyebrow, heading, description, ctas = [] } = Astro.props;
---

<section class="relative overflow-hidden bg-white pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div
    class="pointer-events-none absolute inset-x-0 -top-40 -z-10 h-[560px] bg-[radial-gradient(60%_60%_at_50%_0%,var(--color-brand-100),transparent)]"
    aria-hidden="true"
  >
  </div>

  <Container class="grid items-center gap-16 lg:grid-cols-2">
    <div class="animate-fade-up">
      {eyebrow && (
        <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-brand-700">
          {eyebrow}
        </p>
      )}
      <h1 class="text-4xl font-extrabold leading-[1.08] text-ink-900 sm:text-5xl lg:text-[3.25rem]">
        {heading}
      </h1>
      {description && <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-500">{description}</p>}

      {ctas.length > 0 && (
        <div class="mt-9 flex flex-wrap items-center gap-4">
          {ctas.map((cta) => (
            <Button href={resolveLink(cta.link)} variant={cta.style} size="lg">
              {cta.label}
            </Button>
          ))}
        </div>
      )}

      <div class="mt-10 flex items-center gap-6 text-sm text-ink-400">
        <span class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-success"></span>
          Live attendance &amp; billing
        </span>
        <span class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-brand-400"></span>
          Built for nursery teams
        </span>
      </div>
    </div>

    <div class="animate-fade-up [animation-delay:150ms]" aria-hidden="true">
      <div class="relative mx-auto max-w-md rounded-2xl border border-ink-100 bg-white p-5 shadow-soft-lg">
        <div class="flex items-center justify-between border-b border-ink-100 pb-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-ink-400">Live Dashboard</p>
            <p class="text-lg font-bold text-ink-900">Today, 8:45 AM</p>
          </div>
          <Badge tone="success">● Live</Badge>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-ink-50 p-4">
            <p class="text-xs font-semibold text-ink-400">Children Present</p>
            <p class="mt-1 text-2xl font-extrabold text-ink-900">42<span class="text-sm font-semibold text-ink-400">/50</span></p>
          </div>
          <div class="rounded-xl bg-ink-50 p-4">
            <p class="text-xs font-semibold text-ink-400">Active Staff</p>
            <p class="mt-1 text-2xl font-extrabold text-ink-900">11</p>
          </div>
        </div>

        <div class="mt-4 space-y-3">
          <div class="flex items-center gap-3 rounded-xl border border-ink-100 p-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">AM</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-ink-800">Amira checked in</p>
              <p class="text-xs text-ink-400">Giraffe Room · 8:12 AM</p>
            </div>
            <Badge tone="success">Present</Badge>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-ink-100 p-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-coral-soft text-xs font-bold text-ink-700">DL</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-ink-800">Daily report shared</p>
              <p class="text-xs text-ink-400">Lunch, nap &amp; a photo</p>
            </div>
            <Badge tone="brand">New</Badge>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
