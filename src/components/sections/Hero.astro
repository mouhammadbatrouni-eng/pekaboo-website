---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import PortalScreen from "../product/PortalScreen.astro";
import ParentAppScreen from "../product/ParentAppScreen.astro";
import { resolveLink } from "../../lib/content/resolveLink";
import type { Cta } from "../../lib/content/types";

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  ctas?: Cta[];
}

const { eyebrow, heading, description, ctas = [] } = Astro.props;
---

<section class="relative overflow-hidden pt-14 pb-16 sm:pt-20 sm:pb-24">
  <div
    class="pointer-events-none absolute inset-x-0 -top-48 -z-10 h-[620px] bg-[radial-gradient(58%_58%_at_50%_0%,var(--color-brand-100),transparent)]"
    aria-hidden="true"
  >
  </div>

  <Container>
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
      <div class="animate-fade-up">
        {eyebrow && (
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-200/60 bg-white/80 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-brand-700 shadow-soft">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            {eyebrow}
          </p>
        )}

        <h1 class="text-[2.6rem] leading-[1.02] sm:text-[3.4rem] lg:text-[3.6rem]">
          {heading}
        </h1>

        {description && (
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-500">{description}</p>
        )}

        {ctas.length > 0 && (
          <div class="mt-9 flex flex-wrap items-center gap-3">
            {ctas.map((cta) => (
              <Button href={resolveLink(cta.link)} variant={cta.style} size="lg">
                {cta.label}
              </Button>
            ))}
          </div>
        )}

        <p class="mt-6 text-sm text-ink-400">
          Built for nurseries, preschools and childcare groups.
        </p>
      </div>

      {/* Product composition: the staff portal, with the parent app overlapping it —
          the two halves of the platform, shown together. */}
      {/* The phone is inset just past the portal card's right edge, so the two
          surfaces layer without the app ever covering portal content. */}
      <div class="relative animate-fade-up [animation-delay:120ms]">
        <div class="lg:pr-[158px] xl:pr-[178px]">
          <PortalScreen screen="dashboard" />
        </div>
        <div class="absolute -bottom-6 right-0 hidden w-[178px] lg:block xl:w-[198px]">
          <ParentAppScreen />
        </div>
        <div class="mt-8 flex justify-center lg:hidden">
          <ParentAppScreen class="max-w-[230px]" />
        </div>
      </div>
    </div>
  </Container>
</section>
