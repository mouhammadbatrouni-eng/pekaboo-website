---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import PortalScreen from "../product/PortalScreen.astro";
import { CURRICULA, CURRICULUM_STEPS } from "../../lib/content/marketing";
---

<Section id="curriculum" surface="tint" labelledBy="curriculum-heading">
  <Container>
    <div class="grid gap-14 lg:grid-cols-[1fr_400px] lg:items-center">
      <div>
        <SectionHeading
          id="curriculum-heading"
          align="left"
          eyebrow="Curriculum & assessment"
          title="Your framework, not a fixed template"
          description="Peekaboo doesn't impose a curriculum. You define the learning areas, aspects, objectives and attainment levels your setting works to — then observations and reports follow that structure."
        />

        <ol class="mt-10 grid gap-6 sm:grid-cols-2">
          {CURRICULUM_STEPS.map((item, index) => (
            <li class="relative pl-11">
              <span
                class="absolute left-0 top-0 flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-bold text-brand-700 shadow-soft ring-1 ring-brand-100"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-700">{item.step}</p>
              <p class="mt-1 font-bold text-ink-900">{item.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-400">{item.description}</p>
            </li>
          ))}
        </ol>

        <div class="mt-10 rounded-xl border border-ink-100 bg-white/80 p-6">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink-400">
            Set up by nurseries working to
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {CURRICULA.map((curriculum) => (
              <li
                class="rounded-full border border-ink-100 bg-white px-3.5 py-1.5 text-sm font-semibold text-ink-700"
                title={curriculum.name}
              >
                {curriculum.abbr}
                <span class="sr-only"> — {curriculum.name}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-ink-400">
            Because the framework is yours to define, Peekaboo can be configured for these or for a
            structure specific to your setting.
          </p>
        </div>
      </div>

      <div class="lg:sticky lg:top-28">
        <PortalScreen screen="observation" />
      </div>
    </div>
  </Container>
</Section>
