---
import Container from "../ui/Container.astro";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import type { Feature } from "../../lib/content/types";

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  features: Feature[];
}

const { eyebrow, heading, description, features } = Astro.props;

// Avoid an orphaned lone card in the last row: use a 3-column grid only
// when the count divides evenly into 3, otherwise a clean 2-column grid.
const gridCols = features.length > 0 && features.length % 3 === 0 ? "lg:grid-cols-3" : "lg:grid-cols-2";
---

<section class="py-20 sm:py-28" id="features">
  <Container>
    <SectionHeading eyebrow={eyebrow} title={heading} description={description} />

    <div class:list={["mt-14 grid gap-6 sm:grid-cols-2", gridCols]}>
      {features.map((feature) => (
        <Card as="article" hover class="flex flex-col">
          <FeatureIcon icon={feature.icon} class="h-11 w-11" />
          <h3 class="mt-5 text-lg font-bold text-ink-900">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{feature.summary}</p>
        </Card>
      ))}
    </div>
  </Container>
</section>
