---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { urlForImage } from "../../lib/sanity/image";
import type { Testimonial } from "../../lib/content/types";

interface Props {
  eyebrow?: string;
  heading?: string;
  testimonials: Testimonial[];
}

const {
  eyebrow = "Customers",
  heading = "What nurseries say",
  testimonials,
} = Astro.props;
---

{/* Rendered only when real, attributable quotes exist in Sanity. We don't ship
    placeholder testimonials — an empty section is more honest than a fake one. */}
{testimonials.length > 0 && (
  <Section id="testimonials" labelledBy="testimonials-heading">
    <Container>
      <SectionHeading id="testimonials-heading" eyebrow={eyebrow} title={heading} />

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((testimonial) => {
          const photoUrl = urlForImage(testimonial.photo)?.width(96).height(96).url();
          return (
            <figure class="flex flex-col justify-between rounded-xl border border-ink-100 bg-white/90 p-7 shadow-soft">
              <blockquote class="text-[15px] leading-relaxed text-ink-700">
                &ldquo;{testimonial.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3 border-t border-ink-100 pt-5">
                {photoUrl ? (
                  <img
                    src={photoUrl}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    class="h-10 w-10 rounded-full object-cover"
                  />
                ) : (
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                    {testimonial.authorName.charAt(0)}
                  </span>
                )}
                <div>
                  <p class="text-sm font-bold text-ink-900">{testimonial.authorName}</p>
                  <p class="text-xs text-ink-400">
                    {[testimonial.authorRole, testimonial.nurseryName].filter(Boolean).join(" · ")}
                  </p>
                </div>
              </figcaption>
            </figure>
          );
        })}
      </div>
    </Container>
  </Section>
)}
