---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import { OUTCOMES } from "../../lib/content/marketing";
---

<Section id="outcomes" labelledBy="outcomes-heading">
  <Container>
    <SectionHeading
      id="outcomes-heading"
      eyebrow="Why Peekaboo"
      title="What actually changes for your setting"
      description="Not features for their own sake — the difference each one makes to a working week."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {OUTCOMES.map((outcome) => (
        <article class="rounded-xl border border-ink-100 bg-white/90 p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft-lg">
          <FeatureIcon icon={outcome.icon} class="h-11 w-11" />
          <h3 class="mt-5 font-heading text-lg tracking-[-0.02em] text-ink-900">{outcome.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{outcome.description}</p>
        </article>
      ))}
    </div>
  </Container>
</Section>
