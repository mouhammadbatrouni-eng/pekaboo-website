---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { PortableText } from "astro-portabletext";
import { ChevronDown } from "@lucide/astro";
import type { Faq } from "../../lib/content/types";

interface Props {
  eyebrow?: string;
  heading: string;
  faqs: Faq[];
}

const { eyebrow, heading, faqs } = Astro.props;

/** Answers arrive as portable text from Sanity, or a plain string from the bundled set. */
const isPlainText = (answer: Faq["answer"]): answer is string => typeof answer === "string";
---

<Section id="faq" surface="tint" labelledBy="faq-heading">
  <Container class="max-w-3xl">
    <SectionHeading id="faq-heading" eyebrow={eyebrow} title={heading} />

    <div class="mt-12 divide-y divide-ink-100 overflow-hidden rounded-xl border border-ink-100 bg-white">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-semibold text-ink-900 marker:content-none hover:bg-brand-50/40 focus-visible:bg-brand-50/40">
            {faq.question}
            <ChevronDown
              size={18}
              class="shrink-0 text-ink-400 transition-transform duration-200 group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="px-6 pb-5 text-[15px] leading-relaxed text-ink-500">
            {isPlainText(faq.answer) ? <p>{faq.answer}</p> : <PortableText value={faq.answer} />}
          </div>
        </details>
      ))}
    </div>
  </Container>
</Section>
