---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import { ArrowRight, Check } from "@lucide/astro";
import { PRODUCTS } from "../../lib/content/solutions";
---

<Section id="ecosystem" labelledBy="ecosystem-heading">
  <Container>
    <SectionHeading
      id="ecosystem-heading"
      eyebrow="One platform, two sides"
      title="The nursery runs it. Families live it."
      description="Peekaboo is one system with two front doors — a portal your team works in, and an app families follow. What happens in the room reaches parents without anyone writing it twice."
    />

    <div class="relative mt-14 grid gap-6 lg:grid-cols-2">
      {PRODUCTS.map((product) => (
        <article class="group relative flex flex-col rounded-xl border border-ink-100 bg-white/90 p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft-lg sm:p-8">
          <div class="flex items-center gap-3">
            <FeatureIcon icon={product.icon} class="h-11 w-11" />
            <div>
              <h3 class="font-heading text-2xl tracking-[-0.03em] text-ink-900">{product.name}</h3>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-700">
                {product.audience} · {product.surface}
              </p>
            </div>
          </div>

          <p class="mt-5 leading-relaxed text-ink-500">{product.description}</p>

          <ul class="mt-6 space-y-2.5">
            {product.highlights.map((highlight) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700">
                <span class="mt-0.5 flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
                  <Check size={11} stroke-width={3} aria-hidden="true" />
                </span>
                {highlight}
              </li>
            ))}
          </ul>

          <a
            href={product.href}
            class="mt-7 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 transition-colors hover:text-brand-800"
          >
            Explore {product.name}
            <ArrowRight size={15} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <p class="mx-auto mt-10 max-w-xl text-center text-sm leading-relaxed text-ink-400">
      A daily report drafted in the Giraffe room at 3pm is in a parent's hand at 3:01 — the same record, not a copy of it.
    </p>
  </Container>
</Section>
