---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import PortalScreen from "../product/PortalScreen.astro";
import { Check, ArrowRight } from "@lucide/astro";
import { MODULE_CATEGORIES } from "../../lib/content/modules";
---

<Section id="platform" surface="tint" labelledBy="platform-heading">
  <Container>
    <SectionHeading
      id="platform-heading"
      eyebrow="The platform"
      title="Everything a nursery runs on, in one place"
      description="Seven areas of the platform, each built around a real part of your day. Choose one to see what it covers."
    />

    <div class="mt-14" data-module-explorer>
      <div class="grid gap-8 lg:grid-cols-[260px_1fr] lg:gap-12">
        {/* Category rail — a real tablist so arrow keys and screen readers work */}
        <div
          role="tablist"
          aria-label="Platform areas"
          aria-orientation="vertical"
          class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible lg:pb-0"
        >
          {MODULE_CATEGORIES.map((category, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${category.id}`}
              aria-controls={`panel-${category.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-category-tab={category.id}
              class="flex shrink-0 items-center gap-3 rounded-full border border-ink-100 bg-white px-4 py-2.5 text-left text-sm font-semibold text-ink-600 transition-all hover:border-brand-200 hover:text-brand-700 aria-selected:border-brand-300 aria-selected:bg-brand-50 aria-selected:text-brand-700 aria-selected:shadow-soft lg:rounded-xl lg:px-4 lg:py-3"
            >
              <FeatureIcon icon={category.icon} tone={category.tone} class="h-8 w-8 shrink-0" />
              <span class="whitespace-nowrap lg:whitespace-normal">{category.label}</span>
            </button>
          ))}
        </div>

        {/* Panels */}
        <div>
          {MODULE_CATEGORIES.map((category, index) => (
            <div
              role="tabpanel"
              id={`panel-${category.id}`}
              aria-labelledby={`tab-${category.id}`}
              data-category-panel={category.id}
              hidden={index !== 0}
              tabindex="0"
            >
              <div class="grid gap-10 lg:grid-cols-[1fr_340px] lg:items-start xl:grid-cols-[1fr_400px]">
                <div>
                  <h3 class="font-heading text-2xl tracking-[-0.03em] text-ink-900 sm:text-3xl">
                    {category.title}
                  </h3>
                  <p class="mt-3 max-w-xl leading-relaxed text-ink-500">{category.summary}</p>

                  <ul class="mt-7 grid gap-x-8 gap-y-5 sm:grid-cols-2">
                    {category.capabilities.map((capability) => (
                      <li>
                        <p class="flex items-center gap-2 text-sm font-bold text-ink-900">
                          <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
                            <Check size={10} stroke-width={3.5} aria-hidden="true" />
                          </span>
                          {capability.name}
                        </p>
                        <p class="mt-1 pl-6 text-sm leading-relaxed text-ink-400">
                          {capability.description}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="lg:sticky lg:top-28">
                  <PortalScreen screen={category.preview} />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Always-visible route to the full detail — and the fallback path to
          every area if the tab script hasn't run. */}
      <div class="mt-12 text-center">
        <a
          href="/features"
          class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-5 py-2.5 text-sm font-bold text-ink-700 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-700"
        >
          See all seven areas in detail
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>
    </div>
  </Container>
</Section>

<script>
  // Upgrades the rail into a keyboard-navigable tablist. If this never runs,
  // the first panel stays open and the "See all seven areas" link below leads
  // to /features, where every area is a full page section.
  const explorer = document.querySelector("[data-module-explorer]");
  if (explorer) {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-category-tab]"));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>("[data-category-panel]"));

    function select(id: string, focusTab = false) {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.categoryTab === id;
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && focusTab) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.categoryPanel !== id;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab.dataset.categoryTab!));
    });

    explorer.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      const currentIndex = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      if (currentIndex === -1) return;

      let nextIndex: number | null = null;
      if (key === "ArrowDown" || key === "ArrowRight") nextIndex = (currentIndex + 1) % tabs.length;
      if (key === "ArrowUp" || key === "ArrowLeft") nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      if (key === "Home") nextIndex = 0;
      if (key === "End") nextIndex = tabs.length - 1;

      if (nextIndex !== null) {
        event.preventDefault();
        select(tabs[nextIndex].dataset.categoryTab!, true);
      }
    });
  }
</script>
