---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import BrowserFrame from "../ui/BrowserFrame.astro";
import PhoneFrame from "../ui/PhoneFrame.astro";
import Badge from "../ui/Badge.astro";
import { Camera, Users, House, MessageCircle, Grid2x2, Settings } from "@lucide/astro";

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
}

const { eyebrow, heading, description } = Astro.props;

const rooms = [
  { name: "Giraffe", present: 8, total: 10, tone: "bg-brand-500" },
  { name: "Rabbit", present: 6, total: 12, tone: "bg-success" },
  { name: "Lion Cubs", present: 4, total: 8, tone: "bg-warning" },
];
---

<section class="bg-ink-50/60 py-20 sm:py-28" id="showcase">
  <Container>
    <SectionHeading eyebrow={eyebrow} title={heading} description={description} />

    <div class="mt-16 grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]">
      <BrowserFrame label="peek.peek-a-boo.app/dashboard">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-ink-400">Live Dashboard</p>
            <p class="text-lg font-bold text-white">Monday, overview</p>
          </div>
          <Badge tone="success">● Live</Badge>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-3">
          <div class="rounded-xl bg-white/5 p-3">
            <p class="text-[11px] font-semibold text-ink-400">Present</p>
            <p class="mt-1 text-xl font-extrabold text-white">18<span class="text-xs text-ink-400">/30</span></p>
          </div>
          <div class="rounded-xl bg-white/5 p-3">
            <p class="text-[11px] font-semibold text-ink-400">Absent</p>
            <p class="mt-1 text-xl font-extrabold text-white">2</p>
          </div>
          <div class="rounded-xl bg-white/5 p-3">
            <p class="text-[11px] font-semibold text-ink-400">Staff</p>
            <p class="mt-1 text-xl font-extrabold text-white">8</p>
          </div>
        </div>

        <div class="mt-5 rounded-xl bg-white/5 p-4">
          <p class="text-[11px] font-bold uppercase tracking-wide text-ink-400">Classroom Occupancy</p>
          <div class="mt-3 space-y-3">
            {rooms.map((room) => (
              <div>
                <div class="flex items-center justify-between text-xs text-ink-300">
                  <span class="font-semibold text-white">{room.name}</span>
                  <span>{room.present}/{room.total}</span>
                </div>
                <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                  <div class={`h-full rounded-full ${room.tone}`} style={`width:${(room.present / room.total) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </BrowserFrame>

      <PhoneFrame>
        <div class="flex items-center justify-between px-4 pb-3">
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 text-white">
              <Camera size={16} stroke-width={2.4} />
            </span>
            <span class="text-base font-extrabold text-ink-900">TimeLine</span>
          </div>
          <Settings size={18} class="text-ink-300" />
        </div>

        <div class="flex gap-2 overflow-hidden px-4 pb-3">
          <span class="whitespace-nowrap rounded-full bg-brand-500 px-3 py-1 text-[11px] font-semibold text-white">All Classes</span>
          <span class="whitespace-nowrap rounded-full bg-ink-100 px-3 py-1 text-[11px] font-semibold text-ink-500">Giraffe</span>
          <span class="whitespace-nowrap rounded-full bg-ink-100 px-3 py-1 text-[11px] font-semibold text-ink-500">Rabbit</span>
        </div>

        <div class="space-y-3 px-4 pb-4">
          <div class="overflow-hidden rounded-xl border border-ink-100">
            <div class="h-24 bg-gradient-to-br from-brand-300/50 via-brand-200 to-violet/30"></div>
            <div class="p-2.5">
              <p class="text-xs font-semibold text-ink-800">Art class photos</p>
              <p class="text-[10px] text-ink-400">Ms. Grace · 13 mins ago</p>
            </div>
          </div>
          <div class="overflow-hidden rounded-xl border border-ink-100">
            <div class="h-16 bg-gradient-to-br from-mint/40 via-brand-100 to-gold-300/50"></div>
            <div class="p-2.5">
              <p class="text-xs font-semibold text-ink-800">Today I ate lunch well 🍎</p>
              <p class="text-[10px] text-ink-400">Daily report · 20 mins ago</p>
            </div>
          </div>
        </div>

        <div class="mt-auto flex items-center justify-around border-t border-ink-100 py-3">
          <Camera size={18} class="text-brand-600" />
          <Users size={18} class="text-ink-300" />
          <House size={18} class="text-ink-300" />
          <MessageCircle size={18} class="text-ink-300" />
          <Grid2x2 size={18} class="text-ink-300" />
        </div>
      </PhoneFrame>
    </div>
  </Container>
</section>
