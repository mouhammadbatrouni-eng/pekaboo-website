---
import Container from "../ui/Container.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
}

const { eyebrow, heading, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-white pt-16 pb-14 sm:pt-20 sm:pb-16">
  <div
    class="pointer-events-none absolute inset-x-0 -top-40 -z-10 h-[420px] bg-[radial-gradient(55%_60%_at_50%_0%,var(--color-brand-100),transparent)]"
    aria-hidden="true"
  >
  </div>
  <Container class="max-w-3xl text-center">
    {eyebrow && (
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-brand-700">
        {eyebrow}
      </p>
    )}
    <h1 class="text-4xl font-extrabold leading-tight text-ink-900 sm:text-5xl">{heading}</h1>
    {intro && <p class="mt-5 text-lg leading-relaxed text-ink-500">{intro}</p>}
  </Container>
</section>
