---
import PortalFrameChrome from "./PortalFrameChrome.astro";
import { House, CalendarCheck, BookOpen, Users, MessageCircle, Wallet, Sparkles } from "@lucide/astro";
import { getDict } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

/**
 * The admissions pipeline in Peekaboo Care, drawn in markup.
 *
 * The last portal screen on the site not backed by a real capture. It is
 * styled to match the captures beside it — same browser chrome, same light
 * surface, same rail — so the page doesn't read as two different products.
 * Replace it with a real capture and delete this file.
 */
interface Props {
  class?: string;
  lang?: Lang;
}

const { class: className = "", lang = "en" } = Astro.props;
const p = getDict(lang).product;
const rtl = lang === "ar";

const railItems = [
  { key: "dashboard", icon: House },
  { key: "attendance", icon: CalendarCheck },
  { key: "learning", icon: BookOpen },
  { key: "people", icon: Users },
  { key: "messages", icon: MessageCircle },
  { key: "finance", icon: Wallet },
  { key: "admissions", icon: Sparkles },
] as const;

const leads = [
  { stage: p.stages[0], count: 12, tone: "bg-brand-500" },
  { stage: p.stages[1], count: 7, tone: "bg-violet" },
  { stage: p.stages[2], count: 5, tone: "bg-gold-400" },
  { stage: p.stages[3], count: 4, tone: "bg-coral" },
  { stage: p.stages[4], count: 9, tone: "bg-mint" },
];
const maxLead = Math.max(...leads.map((lead) => lead.count));

const checklist = [
  { label: p.checklist[0], done: true },
  { label: p.checklist[1], done: true },
  { label: p.checklist[2], done: true },
  { label: p.checklist[3], done: false },
];
---

<PortalFrameChrome class={className}>
  <div class="flex bg-[#fdfaf6]" dir={rtl ? "rtl" : "ltr"}>
    {/* The portal's sidebar, condensed to its rail */}
    <div class="hidden shrink-0 flex-col gap-1 border-e border-ink-100 px-2 py-4 sm:flex">
      {railItems.map(({ key, icon: Icon }) => (
        <span
          class:list={[
            "flex h-9 w-9 items-center justify-center rounded-lg",
            key === "admissions" ? "bg-brand-500/12 text-brand-600" : "text-ink-300",
          ]}
        >
          <Icon size={16} stroke-width={2} aria-hidden="true" />
        </span>
      ))}
    </div>

    <div class="min-w-0 flex-1 p-4 sm:p-5">
      <div class="rounded-xl bg-white p-4 shadow-soft">
        <p class="truncate text-[10px] font-bold uppercase tracking-[0.12em] text-ink-400">{p.admissionsCrm}</p>
        <p class="truncate font-heading text-lg tracking-[-0.03em] text-ink-900 sm:text-xl">{p.leadPipeline}</p>
      </div>

      <div class="mt-3 rounded-xl bg-white p-4 shadow-soft">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-400">{p.last30Days}</p>
        <div class="mt-3 space-y-2.5">
          {leads.map((lead) => (
            <div>
              <div class="flex items-center justify-between text-[11px]">
                <span class="font-semibold text-ink-800">{lead.stage}</span>
                <span class="text-ink-400">{lead.count}</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-ink-100">
                <div class={`h-full rounded-full ${lead.tone}`} style={`width:${(lead.count / maxLead) * 100}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-3 rounded-xl bg-white p-4 shadow-soft">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-400">{p.enrolmentChecklist}</p>
        <div class="mt-2 grid grid-cols-2 gap-1.5">
          {checklist.map((item) => (
            <div class="flex items-center gap-1.5">
              <span
                class:list={[
                  "flex h-3.5 w-3.5 items-center justify-center rounded-full text-[8px] font-bold",
                  item.done ? "bg-mint-soft text-success" : "bg-ink-100 text-ink-400",
                ]}
              >
                {item.done ? "✓" : ""}
              </span>
              <span class:list={["text-[10px]", item.done ? "text-ink-700" : "text-ink-400"]}>{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</PortalFrameChrome>
