---
import { Camera, Users, House, MessageCircle, Grid2x2 } from "@lucide/astro";

/**
 * The phone chrome only. Content is supplied via slot, so callers can render a
 * single screen or stack several and cross-fade between them.
 */
interface Props {
  class?: string;
  title?: string;
  rtl?: boolean;
  /** Fixed body height, needed when stacking screens absolutely. */
  bodyHeight?: string;
}

const { class: className = "", title = "TimeLine", rtl = false, bodyHeight } = Astro.props;
---

<div
  class:list={[
    "w-full max-w-[268px] rounded-[2.25rem] border-[7px] border-ink-900 bg-ink-900 shadow-soft-lg",
    className,
  ]}
>
  <div class="relative overflow-hidden rounded-[1.7rem] bg-white" dir={rtl ? "rtl" : "ltr"}>
    <div class="absolute left-1/2 top-2 z-10 h-4 w-20 -translate-x-1/2 rounded-full bg-ink-900"></div>

    <div class="flex items-center justify-between px-4 pb-3 pt-9">
      <div class="flex items-center gap-2">
        <img src="/peekaboo-mark.png" alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
        <span class="font-heading text-lg tracking-[-0.03em] text-brand-700">{title}</span>
      </div>
      <span class="h-6 w-6 rounded-full bg-ink-100"></span>
    </div>

    <div class="relative" style={bodyHeight ? `height:${bodyHeight}` : undefined}>
      <slot />
    </div>

    <div class="flex items-center justify-around border-t border-ink-100 py-2.5">
      <Camera size={16} class="text-brand-700" aria-hidden="true" />
      <Users size={16} class="text-ink-300" aria-hidden="true" />
      <House size={16} class="text-ink-300" aria-hidden="true" />
      <MessageCircle size={16} class="text-ink-300" aria-hidden="true" />
      <Grid2x2 size={16} class="text-ink-300" aria-hidden="true" />
    </div>
  </div>
</div>
