---
/**
 * The Peekaboo Care portal, reproduced in markup.
 *
 * Layout, chrome, sidebar grouping and colour values are taken from the real
 * portal so these previews read as the actual product rather than an
 * invented interface — but rendered in code so they stay crisp on any
 * display, adapt down to mobile, and carry clean demo data instead of the
 * seeded test records in the live environment.
 */
import { House, CalendarCheck, BookOpen, Users, MessageCircle, Wallet, Sparkles } from "@lucide/astro";

interface Props {
  eyebrow?: string;
  title: string;
  /** Small pill in the top-right of the page header, e.g. "Live". */
  badge?: string;
  /** Which sidebar rail icon reads as the current section. */
  active?: "dashboard" | "attendance" | "learning" | "people" | "messages" | "finance" | "admissions";
  class?: string;
  /** Mirrors the mock interface, matching the portal's own Arabic layout. */
  rtl?: boolean;
}

const { eyebrow, title, badge, active = "dashboard", class: className = "", rtl = false } = Astro.props;

const railItems = [
  { key: "dashboard", icon: House, label: "Live Dashboard" },
  { key: "attendance", icon: CalendarCheck, label: "Attendance" },
  { key: "learning", icon: BookOpen, label: "Early Childhood" },
  { key: "people", icon: Users, label: "Children & Staff" },
  { key: "messages", icon: MessageCircle, label: "Messages" },
  { key: "finance", icon: Wallet, label: "Finance" },
  { key: "admissions", icon: Sparkles, label: "Admissions CRM" },
] as const;
---

<div
  class:list={[
    "overflow-hidden rounded-xl border border-ink-900/10 bg-white shadow-soft-lg",
    className,
  ]}
>
  {/* Browser chrome */}
  <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-3 py-2.5 sm:px-4">
    <span class="h-2.5 w-2.5 rounded-full bg-danger/40"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-warning/40"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-success/40"></span>
    <span class="ml-2 truncate rounded-full bg-white px-3 py-1 text-[10px] font-medium text-ink-400 sm:text-[11px]">
      portal.peek-a-boo.app
    </span>
  </div>

  {/* Portal body */}
  <div class="flex bg-ink-950" dir={rtl ? "rtl" : "ltr"}>
    {/* Icon rail — the portal's sidebar, condensed */}
    <div class="hidden shrink-0 flex-col gap-1 border-r border-white/5 px-2 py-4 sm:flex">
      {railItems.map(({ key, icon: Icon, label }) => (
        <span
          class:list={[
            "flex h-9 w-9 items-center justify-center rounded-lg transition-colors",
            key === active ? "bg-brand-500/20 text-brand-300" : "text-ink-500",
          ]}
          title={label}
        >
          <Icon size={16} stroke-width={2} aria-hidden="true" />
        </span>
      ))}
    </div>

    <div class="min-w-0 flex-1 p-4 sm:p-5">
      {/* Page header */}
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          {eyebrow && (
            <p class="truncate text-[10px] font-bold uppercase tracking-[0.12em] text-ink-500">{eyebrow}</p>
          )}
          <p class="truncate font-heading text-lg tracking-[-0.03em] text-white sm:text-xl">{title}</p>
        </div>
        {badge && (
          <span class="flex shrink-0 items-center gap-1.5 rounded-full bg-success-onDark/15 px-2.5 py-1 text-[10px] font-bold text-success-onDark">
            <span class="h-1.5 w-1.5 rounded-full bg-success-onDark"></span>
            {badge}
          </span>
        )}
      </div>

      <div class="mt-4">
        <slot />
      </div>
    </div>
  </div>
</div>
