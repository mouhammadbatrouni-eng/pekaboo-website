---
import { Heart, MessageSquare, Share2, Check } from "@lucide/astro";

/**
 * The inner content of a Peekaboo Parent app screen, without the phone shell.
 *
 * Split out from ParentAppScreen so the scroll-driven story can stack several
 * screens inside a single sticky phone and cross-fade between them.
 */
export type ParentScreen = "timeline" | "dailyReport" | "messages" | "development" | "payments";

interface Props {
  screen: ParentScreen;
  rtl?: boolean;
}

const { screen, rtl = false } = Astro.props;
---

{screen === "timeline" && (
  <>
    <div class="flex gap-1.5 overflow-hidden px-4 pb-3">
      {(rtl ? ["كل الفصول", "الزرافة", "الأرنب"] : ["All classes", "Giraffe", "Rabbit"]).map((chip, i) => (
        <span
          class:list={[
            "whitespace-nowrap rounded-full px-2.5 py-1 text-[10px] font-semibold",
            i === 0 ? "bg-brand-500 text-white" : "bg-ink-100 text-ink-500",
          ]}
        >
          {chip}
        </span>
      ))}
    </div>
    <div class="space-y-2.5 px-4 pb-4">
      <div class="overflow-hidden rounded-xl border border-ink-100">
        <div class="h-24 bg-gradient-to-br from-brand-200 via-brand-100 to-violet/25"></div>
        <div class="p-2.5">
          <p class="text-[11px] font-bold text-ink-800">
            {rtl ? "صباح في حديقة الحواس" : "Morning in the sensory garden"}
          </p>
          <p class="mt-0.5 text-[9px] text-ink-400">
            {rtl ? "الآنسة غريس · قبل ١٢ دقيقة" : "Ms. Grace · 12 minutes ago"}
          </p>
          <div class="mt-2 flex items-center gap-3 border-t border-ink-100 pt-2 text-ink-300">
            <Heart size={13} aria-hidden="true" />
            <MessageSquare size={13} aria-hidden="true" />
            <Share2 size={13} aria-hidden="true" />
          </div>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl border border-ink-100 p-2.5">
        <span class="rounded-full bg-gold-100 px-2 py-0.5 text-[9px] font-bold text-gold-700">
          {rtl ? "التقرير اليومي" : "Daily report"}
        </span>
        <p class="mt-1.5 text-[11px] font-bold text-ink-800">
          {rtl ? "أكلت كل غدائي اليوم" : "I ate all of my lunch today"}
        </p>
      </div>
    </div>
  </>
)}

{screen === "dailyReport" && (
  <div class="space-y-2.5 px-4 pb-4">
    <div class="rounded-xl bg-brand-50 p-3 text-center">
      <p class="text-[9px] font-bold uppercase tracking-wide text-brand-700">Today I was</p>
      <p class="mt-0.5 font-heading text-2xl text-ink-900">Happy</p>
    </div>
    {[
      { label: "Breakfast", value: "Most" },
      { label: "Lunch", value: "All" },
      { label: "Nap", value: "Slept well · 1h 20m" },
      { label: "Nappy changes", value: "3" },
    ].map((row) => (
      <div class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2">
        <span class="text-[10px] font-semibold text-ink-500">{row.label}</span>
        <span class="text-[11px] font-bold text-ink-800">{row.value}</span>
      </div>
    ))}
  </div>
)}

{screen === "messages" && (
  <div class="space-y-2.5 px-4 pb-4">
    <div class="rounded-xl border border-ink-100 p-2.5">
      <span class="rounded-full bg-brand-100 px-2 py-0.5 text-[9px] font-bold text-brand-700">Announcement</span>
      <p class="mt-1.5 text-[11px] font-bold text-ink-800">Sports day — Thursday 14th</p>
      <p class="mt-1 text-[9px] leading-relaxed text-ink-400">
        Please send trainers and a sun hat. We start at 9:30 in the garden.
      </p>
    </div>
    <div class="rounded-xl border border-ink-100 p-2.5">
      <span class="rounded-full bg-violet-soft px-2 py-0.5 text-[9px] font-bold text-[#6250c9]">Event</span>
      <p class="mt-1.5 text-[11px] font-bold text-ink-800">Parent evening</p>
      <p class="mt-0.5 text-[9px] text-ink-400">Tue 19 Aug · 4:00–6:00 pm</p>
    </div>
    <div class="rounded-xl bg-ink-50 p-2.5">
      <p class="text-[9px] font-semibold text-ink-400">Ms. Grace · Giraffe room</p>
      <p class="mt-1 text-[11px] leading-relaxed text-ink-700">
        Amira asked about her painting again — I've sent a photo to the feed.
      </p>
    </div>
  </div>
)}

{screen === "development" && (
  <div class="space-y-2.5 px-4 pb-4">
    <div class="rounded-xl border border-ink-100 p-3">
      <p class="text-[9px] font-bold uppercase tracking-wide text-ink-400">Learning journal</p>
      <p class="mt-1.5 text-[11px] leading-relaxed text-ink-700">
        Counted to four while stacking blocks, then rebuilt the tower unprompted.
      </p>
    </div>
    {[
      { area: "Mathematics", level: "Expected", tone: "bg-mint-soft text-success" },
      { area: "Communication", level: "Emerging", tone: "bg-gold-100 text-gold-700" },
      { area: "Physical", level: "Expected", tone: "bg-mint-soft text-success" },
    ].map((row) => (
      <div class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2">
        <span class="text-[10px] font-semibold text-ink-700">{row.area}</span>
        <span class:list={["rounded-full px-2 py-0.5 text-[9px] font-bold", row.tone]}>{row.level}</span>
      </div>
    ))}
  </div>
)}

{screen === "payments" && (
  <div class="space-y-2.5 px-4 pb-4">
    <div class="rounded-xl bg-ink-950 p-3 text-center">
      <p class="text-[9px] font-bold uppercase tracking-wide text-ink-400">Balance due</p>
      <p class="mt-0.5 font-heading text-2xl text-white">AED 950</p>
      <p class="text-[9px] text-ink-400">Due 30 August</p>
    </div>
    {[
      { ref: "INV-1042", note: "August fees", state: "Due", tone: "bg-gold-100 text-gold-700" },
      { ref: "INV-1031", note: "July fees", state: "Paid", tone: "bg-mint-soft text-success" },
      { ref: "INV-1020", note: "June fees", state: "Paid", tone: "bg-mint-soft text-success" },
    ].map((row) => (
      <div class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2">
        <div class="min-w-0">
          <p class="truncate text-[11px] font-bold text-ink-800">{row.ref}</p>
          <p class="text-[9px] text-ink-400">{row.note}</p>
        </div>
        <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[9px] font-bold", row.tone]}>
          {row.state === "Paid" && <Check size={9} stroke-width={4} class="mr-0.5 inline" aria-hidden="true" />}
          {row.state}
        </span>
      </div>
    ))}
  </div>
)}
