---
import { Camera, Users, House, MessageCircle, Grid2x2, Heart, MessageSquare, Share2 } from "@lucide/astro";

/**
 * The Peekaboo Parent app, reproduced in markup. Structure follows the app's
 * real design: a "TimeLine" feed with class filter chips and a five-item
 * bottom tab bar (Feed / My Class / Home / Messages / More).
 */
interface Props {
  screen?: "timeline" | "dailyReport";
  class?: string;
  /** Renders the Arabic, right-to-left variant of the interface. */
  rtl?: boolean;
}

const { screen = "timeline", class: className = "", rtl = false } = Astro.props;
---

<div
  class:list={[
    "mx-auto w-full max-w-[268px] rounded-[2.25rem] border-[7px] border-ink-900 bg-ink-900 shadow-soft-lg",
    className,
  ]}
>
  <div class="relative overflow-hidden rounded-[1.7rem] bg-white" dir={rtl ? "rtl" : "ltr"}>
    <div class="absolute left-1/2 top-2 z-10 h-4 w-20 -translate-x-1/2 rounded-full bg-ink-900"></div>

    <div class="flex items-center justify-between px-4 pb-3 pt-9">
      <div class="flex items-center gap-2">
        <img src="/peekaboo-mark.png" alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
        <span class="font-heading text-lg tracking-[-0.03em] text-brand-700">
          {rtl ? "بيكابو" : "TimeLine"}
        </span>
      </div>
      <span class="h-6 w-6 rounded-full bg-ink-100"></span>
    </div>

    {screen === "timeline" ? (
      <>
        <div class="flex gap-1.5 overflow-hidden px-4 pb-3">
          {(rtl ? ["كل الفصول", "الزرافة", "الأرنب"] : ["All classes", "Giraffe", "Rabbit"]).map((chip, i) => (
            <span
              class:list={[
                "whitespace-nowrap rounded-full px-2.5 py-1 text-[10px] font-semibold",
                i === 0 ? "bg-brand-500 text-white" : "bg-ink-100 text-ink-500",
              ]}
            >
              {chip}
            </span>
          ))}
        </div>

        <div class="space-y-2.5 px-4 pb-4">
          <div class="overflow-hidden rounded-xl border border-ink-100">
            <div class="h-24 bg-gradient-to-br from-brand-200 via-brand-100 to-violet/25"></div>
            <div class="p-2.5">
              <p class="text-[11px] font-bold text-ink-800">
                {rtl ? "صباح في حديقة الحواس" : "Morning in the sensory garden"}
              </p>
              <p class="mt-0.5 text-[9px] text-ink-400">
                {rtl ? "الآنسة غريس · قبل ١٢ دقيقة" : "Ms. Grace · 12 minutes ago"}
              </p>
              <div class="mt-2 flex items-center gap-3 border-t border-ink-100 pt-2 text-ink-300">
                <Heart size={13} aria-hidden="true" />
                <MessageSquare size={13} aria-hidden="true" />
                <Share2 size={13} aria-hidden="true" />
              </div>
            </div>
          </div>
          <div class="overflow-hidden rounded-xl border border-ink-100 p-2.5">
            <span class="rounded-full bg-gold-100 px-2 py-0.5 text-[9px] font-bold text-gold-700">
              {rtl ? "التقرير اليومي" : "Daily report"}
            </span>
            <p class="mt-1.5 text-[11px] font-bold text-ink-800">
              {rtl ? "أكلت كل غدائي اليوم" : "I ate all of my lunch today"}
            </p>
            <p class="mt-0.5 text-[9px] text-ink-400">{rtl ? "قبل ٢٥ دقيقة" : "25 minutes ago"}</p>
          </div>
        </div>
      </>
    ) : (
      <div class="space-y-2.5 px-4 pb-4">
        <div class="rounded-xl bg-brand-50 p-3 text-center">
          <p class="text-[9px] font-bold uppercase tracking-wide text-brand-700">Today I was</p>
          <p class="mt-1 font-heading text-2xl text-ink-900">Happy</p>
        </div>
        {[
          { label: "Breakfast", value: "Most" },
          { label: "Lunch", value: "All" },
          { label: "Nap", value: "Slept well · 1h 20m" },
        ].map((row) => (
          <div class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2">
            <span class="text-[10px] font-semibold text-ink-500">{row.label}</span>
            <span class="text-[11px] font-bold text-ink-800">{row.value}</span>
          </div>
        ))}
      </div>
    )}

    <div class="flex items-center justify-around border-t border-ink-100 py-2.5">
      <Camera size={16} class="text-brand-700" aria-hidden="true" />
      <Users size={16} class="text-ink-300" aria-hidden="true" />
      <House size={16} class="text-ink-300" aria-hidden="true" />
      <MessageCircle size={16} class="text-ink-300" aria-hidden="true" />
      <Grid2x2 size={16} class="text-ink-300" aria-hidden="true" />
    </div>
  </div>
</div>
