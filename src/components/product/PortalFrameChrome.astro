---
/**
 * The browser window a portal screen sits in — traffic lights, address pill,
 * rounded corners, soft border and shadow.
 *
 * Shared by PortalFrame (real captures) and PortalCrmScreen (the one screen
 * still drawn in markup), so both read as the same product on the same page.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-xl border border-ink-900/10 bg-white shadow-soft-lg",
    className,
  ]}
>
  <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-3 py-2.5 sm:px-4">
    <span class="h-2.5 w-2.5 rounded-full bg-danger/40"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-warning/40"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-success/40"></span>
    <span class="ml-2 truncate rounded-full bg-white px-3 py-1 text-[10px] font-medium text-ink-400 sm:text-[11px]">
      portal.peek-a-boo.app
    </span>
  </div>

  <slot />
</div>
