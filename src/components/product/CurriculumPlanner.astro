---
import PortalFrameChrome from "./PortalFrameChrome.astro";
import { House, CalendarCheck, BookOpen, Users, MessageCircle, Wallet, Sparkles } from "@lucide/astro";
import { Check } from "@lucide/astro";
import { getDict } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

/**
 * The curriculum planner, as it works in Peekaboo Care: a theme holds
 * activities, activities map to learning objectives, an observation records
 * what happened, and that feeds the child's journal.
 *
 * Drawn in markup rather than captured, because the point is the chain between
 * four screens rather than any one of them. Styled to match the real captures
 * elsewhere on the page.
 */
interface Props {
  class?: string;
  lang?: Lang;
}

const { class: className = "", lang = "en" } = Astro.props;
const p = getDict(lang).product;
const rtl = lang === "ar";

const railItems = [
  { key: "dashboard", icon: House },
  { key: "attendance", icon: CalendarCheck },
  { key: "learning", icon: BookOpen },
  { key: "people", icon: Users },
  { key: "messages", icon: MessageCircle },
  { key: "finance", icon: Wallet },
  { key: "admissions", icon: Sparkles },
] as const;

const chain = [
  { step: p.theme, value: p.themeValue, tone: "bg-brand-500/12 text-brand-600" },
  { step: p.activity, value: p.activityValue, tone: "bg-mint-soft text-success" },
  { step: p.objective, value: p.objectiveValue, tone: "bg-gold-100 text-gold-700" },
];
---

<PortalFrameChrome class={className}>
  <div class="flex bg-[#fdfaf6]" dir={rtl ? "rtl" : "ltr"}>
    <div class="hidden shrink-0 flex-col gap-1 border-e border-ink-100 px-2 py-4 sm:flex">
      {railItems.map(({ key, icon: Icon }) => (
        <span
          class:list={[
            "flex h-9 w-9 items-center justify-center rounded-lg",
            key === "learning" ? "bg-brand-500/12 text-brand-600" : "text-ink-300",
          ]}
        >
          <Icon size={16} stroke-width={2} aria-hidden="true" />
        </span>
      ))}
    </div>

    <div class="min-w-0 flex-1 p-4 sm:p-5">
      <div class="rounded-xl bg-white p-4 shadow-soft">
        <p class="truncate text-[10px] font-bold uppercase tracking-[0.12em] text-ink-400">{p.curriculumSection}</p>
        <p class="truncate font-heading text-lg tracking-[-0.03em] text-ink-900 sm:text-xl">{p.weeklyPlan}</p>
      </div>

      <div class="mt-3 space-y-2.5">
        {chain.map((item, index) => (
          <div class="relative">
            <div class="rounded-xl bg-white p-3 shadow-soft">
              <div class="flex items-center justify-between gap-2">
                <span class:list={["rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide", item.tone]}>
                  {item.step}
                </span>
                {index === 2 && (
                  <span class="rounded-full bg-mint-soft px-2 py-0.5 text-[9px] font-bold text-success">
                    {p.expected}
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[12px] font-semibold text-ink-800">{item.value}</p>
            </div>
            {index < chain.length - 1 && <div class="ms-4 h-2 w-px bg-ink-200" aria-hidden="true"></div>}
          </div>
        ))}

        <div class="rounded-xl border border-brand-200 bg-brand-50 p-3">
          <p class="text-[9px] font-bold uppercase tracking-wide text-brand-ink">{p.observationToJournal}</p>
          <p class="mt-1.5 text-[11px] leading-relaxed text-ink-700">{p.observationQuote}</p>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {p.journalTags.map((tag) => (
              <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-[9px] font-semibold text-ink-600">
                <Check size={8} stroke-width={4} class="text-success" aria-hidden="true" />
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</PortalFrameChrome>
