---
import PortalShell from "./PortalShell.astro";

/**
 * Renders one of the Peekaboo Care portal screens. Each variant mirrors a
 * real page in the product, with representative (not seeded-test) data.
 */
interface Props {
  screen: "dashboard" | "attendance" | "dailyReport" | "observation" | "invoice" | "crm" | "roster";
  class?: string;
}

const { screen, class: className = "" } = Astro.props;

const rooms = [
  { name: "Giraffe", present: 8, total: 10, tone: "bg-brand-400" },
  { name: "Rabbit", present: 14, total: 20, tone: "bg-mint" },
  { name: "Lion Cubs", present: 11, total: 15, tone: "bg-gold-400" },
  { name: "Wise Owls", present: 6, total: 10, tone: "bg-violet" },
];

const attendance = [
  { name: "Amira Haddad", initials: "AH", room: "Giraffe", status: "Present", tone: "text-success-onDark bg-success-onDark/15" },
  { name: "Noah Bennett", initials: "NB", room: "Giraffe", status: "Present", tone: "text-success-onDark bg-success-onDark/15" },
  { name: "Layla Rahman", initials: "LR", room: "Rabbit", status: "Late", tone: "text-warning-onDark bg-warning-onDark/15" },
  { name: "Omar Farouk", initials: "OF", room: "Rabbit", status: "Excused", tone: "text-brand-300 bg-brand-500/15" },
];

const leads = [
  { stage: "New", count: 12, tone: "bg-brand-400" },
  { stage: "Tour booked", count: 7, tone: "bg-violet" },
  { stage: "Toured", count: 5, tone: "bg-gold-400" },
  { stage: "Waiting list", count: 4, tone: "bg-coral" },
  { stage: "Approved", count: 9, tone: "bg-mint" },
];
const maxLead = Math.max(...leads.map((l) => l.count));
---

{screen === "dashboard" && (
  <PortalShell eyebrow="Nursery Operating System" title="Live Dashboard" badge="Live" active="dashboard" class={className}>
    <div class="grid grid-cols-3 gap-2.5">
      {[
        { label: "Children present", value: "39", sub: "of 55 enrolled" },
        { label: "Absent today", value: "3", sub: "2 excused" },
        { label: "Active staff", value: "12", sub: "across 4 rooms" },
      ].map((stat) => (
        <div class="rounded-lg bg-white/5 p-3">
          <p class="text-[9px] font-semibold uppercase leading-tight tracking-wide text-ink-500">{stat.label}</p>
          <p class="mt-1 font-heading text-xl text-white">{stat.value}</p>
          <p class="truncate text-[10px] text-ink-500">{stat.sub}</p>
        </div>
      ))}
    </div>
    <div class="mt-3 rounded-lg bg-white/5 p-3.5">
      <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Classroom occupancy</p>
      <div class="mt-3 space-y-2.5">
        {rooms.map((room) => (
          <div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-semibold text-white">{room.name}</span>
              <span class="text-ink-400">{room.present}/{room.total}</span>
            </div>
            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
              <div class={`h-full rounded-full ${room.tone}`} style={`width:${(room.present / room.total) * 100}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </PortalShell>
)}

{screen === "attendance" && (
  <PortalShell eyebrow="NOS · Monday, 10 August" title="Attendance" active="attendance" class={className}>
    <div class="flex gap-1.5 overflow-hidden">
      {["All", "Giraffe", "Rabbit", "Lion Cubs"].map((chip, i) => (
        <span
          class:list={[
            "whitespace-nowrap rounded-full px-2.5 py-1 text-[10px] font-semibold",
            i === 0 ? "bg-brand-500 text-white" : "bg-white/8 text-ink-400",
          ]}
        >
          {chip}
        </span>
      ))}
    </div>
    <div class="mt-3 space-y-2">
      {attendance.map((child) => (
        <div class="flex items-center gap-2.5 rounded-lg bg-white/5 p-2.5">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-500/20 text-[10px] font-bold text-brand-300">
            {child.initials}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-[12px] font-semibold text-white">{child.name}</p>
            <p class="text-[10px] text-ink-500">{child.room}</p>
          </div>
          <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold", child.tone]}>
            {child.status}
          </span>
        </div>
      ))}
    </div>
  </PortalShell>
)}

{screen === "dailyReport" && (
  <PortalShell eyebrow="NOS · Daily Reports" title="Amira's day" badge="Published" active="messages" class={className}>
    <div class="space-y-2.5">
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Today I was</p>
        <div class="mt-2 flex gap-1.5">
          {["Happy", "Ok", "Sad", "Tired"].map((mood, i) => (
            <span
              class:list={[
                "rounded-full px-2.5 py-1 text-[10px] font-semibold",
                i === 0 ? "bg-gold-400 text-ink-900" : "bg-white/8 text-ink-500",
              ]}
            >
              {mood}
            </span>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        {[
          { label: "Breakfast", value: "Most" },
          { label: "Lunch", value: "All" },
          { label: "Nap", value: "Slept well" },
          { label: "Milk", value: "120 ml" },
        ].map((row) => (
          <div class="rounded-lg bg-white/5 p-2.5">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">{row.label}</p>
            <p class="mt-0.5 text-[12px] font-semibold text-white">{row.value}</p>
          </div>
        ))}
      </div>
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Note for family</p>
        <p class="mt-1.5 text-[11px] leading-relaxed text-ink-300">
          Amira spent most of the morning in the water tray and asked to go back after lunch. Please send a spare set of clothes tomorrow.
        </p>
      </div>
    </div>
  </PortalShell>
)}

{screen === "observation" && (
  <PortalShell eyebrow="Early Childhood · Observations" title="New observation" active="learning" class={className}>
    <div class="space-y-2.5">
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Observation</p>
        <p class="mt-1.5 text-[11px] leading-relaxed text-ink-300">
          Noah lined up the blocks by size without prompting, then counted them aloud to four before rebuilding the tower.
        </p>
      </div>
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Linked objectives</p>
        <div class="mt-2 space-y-1.5">
          {[
            { area: "Mathematics", objective: "Compares quantities and size", level: "Expected" },
            { area: "Communication", objective: "Uses number names in play", level: "Emerging" },
          ].map((item) => (
            <div class="flex items-center justify-between gap-2 rounded-md bg-white/5 px-2.5 py-1.5">
              <div class="min-w-0">
                <p class="truncate text-[11px] font-semibold text-white">{item.objective}</p>
                <p class="text-[9px] text-ink-500">{item.area}</p>
              </div>
              <span class="shrink-0 rounded-full bg-mint/15 px-2 py-0.5 text-[9px] font-bold text-mint">{item.level}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Next steps</p>
        <p class="mt-1.5 text-[11px] leading-relaxed text-ink-300">
          Offer sorting activities with a wider size range this week.
        </p>
      </div>
    </div>
  </PortalShell>
)}

{screen === "invoice" && (
  <PortalShell eyebrow="Accounts · Invoices" title="Invoice INV-1042" active="finance" class={className}>
    <div class="space-y-2.5">
      <div class="grid grid-cols-3 gap-2.5">
        {[
          { label: "Invoiced", value: "AED 4,850" },
          { label: "Collected", value: "AED 3,900" },
          { label: "Outstanding", value: "AED 950" },
        ].map((stat) => (
          <div class="rounded-lg bg-white/5 p-2.5">
            <p class="truncate text-[9px] font-semibold uppercase tracking-wide text-ink-500">{stat.label}</p>
            <p class="mt-0.5 font-heading text-[15px] text-white">{stat.value}</p>
          </div>
        ))}
      </div>
      <div class="rounded-lg bg-white/5 p-3">
        <div class="flex items-center justify-between border-b border-white/5 pb-2 text-[9px] font-bold uppercase tracking-wide text-ink-500">
          <span>Service</span>
          <span>Amount</span>
        </div>
        {[
          { name: "Full day place — August", qty: "1 ×", amount: "AED 3,200" },
          { name: "Lunch programme", qty: "20 ×", amount: "AED 1,000" },
          { name: "VAT 5%", qty: "", amount: "AED 210" },
        ].map((line) => (
          <div class="flex items-center justify-between gap-2 border-b border-white/5 py-2 last:border-0">
            <div class="min-w-0">
              <p class="truncate text-[11px] font-semibold text-white">{line.name}</p>
              {line.qty && <p class="text-[9px] text-ink-500">{line.qty}</p>}
            </div>
            <span class="shrink-0 text-[11px] font-semibold text-ink-200">{line.amount}</span>
          </div>
        ))}
        <div class="flex items-center justify-between pt-2">
          <span class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Total</span>
          <span class="font-heading text-base text-white">AED 4,410</span>
        </div>
      </div>
    </div>
  </PortalShell>
)}

{screen === "crm" && (
  <PortalShell eyebrow="Admissions CRM" title="Lead pipeline" active="admissions" class={className}>
    <div class="rounded-lg bg-white/5 p-3.5">
      <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Last 30 days</p>
      <div class="mt-3 space-y-2.5">
        {leads.map((lead) => (
          <div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-semibold text-white">{lead.stage}</span>
              <span class="text-ink-400">{lead.count}</span>
            </div>
            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
              <div class={`h-full rounded-full ${lead.tone}`} style={`width:${(lead.count / maxLead) * 100}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-2.5 rounded-lg bg-white/5 p-3">
      <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Enrolment checklist · Layla R.</p>
      <div class="mt-2 grid grid-cols-2 gap-1.5">
        {[
          { label: "Information", done: true },
          { label: "Documents", done: true },
          { label: "Evaluation", done: true },
          { label: "Finance", done: false },
        ].map((item) => (
          <div class="flex items-center gap-1.5">
            <span
              class:list={[
                "flex h-3.5 w-3.5 items-center justify-center rounded-full text-[8px] font-bold",
                item.done ? "bg-success-onDark/20 text-success-onDark" : "bg-white/10 text-ink-500",
              ]}
            >
              {item.done ? "✓" : ""}
            </span>
            <span class:list={["text-[10px]", item.done ? "text-ink-300" : "text-ink-500"]}>{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </PortalShell>
)}

{screen === "roster" && (
  <PortalShell eyebrow="People · Staff" title="Team & ratios" active="people" class={className}>
    <div class="space-y-2.5">
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Ratios today</p>
        <div class="mt-2 space-y-1.5">
          {[
            { room: "Giraffe", ratio: "1 : 4", ok: true },
            { room: "Rabbit", ratio: "1 : 7", ok: true },
            { room: "Lion Cubs", ratio: "1 : 11", ok: false },
          ].map((row) => (
            <div class="flex items-center justify-between rounded-md bg-white/5 px-2.5 py-1.5">
              <span class="text-[11px] font-semibold text-white">{row.room}</span>
              <span
                class:list={[
                  "rounded-full px-2 py-0.5 text-[10px] font-bold",
                  row.ok ? "bg-success-onDark/15 text-success-onDark" : "bg-warning-onDark/15 text-warning-onDark",
                ]}
              >
                {row.ratio}
              </span>
            </div>
          ))}
        </div>
      </div>
      <div class="rounded-lg bg-white/5 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-500">Health alerts</p>
        <div class="mt-2 space-y-1.5">
          {[
            { name: "Amira H.", note: "Peanut allergy", level: "Critical", tone: "bg-danger-onDark/15 text-danger-onDark" },
            { name: "Omar F.", note: "Asthma inhaler", level: "Medium", tone: "bg-warning-onDark/15 text-warning-onDark" },
          ].map((alert) => (
            <div class="flex items-center justify-between gap-2 rounded-md bg-white/5 px-2.5 py-1.5">
              <div class="min-w-0">
                <p class="truncate text-[11px] font-semibold text-white">{alert.note}</p>
                <p class="text-[9px] text-ink-500">{alert.name}</p>
              </div>
              <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[9px] font-bold", alert.tone]}>
                {alert.level}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </PortalShell>
)}
