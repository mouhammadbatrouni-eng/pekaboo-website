---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["mx-auto w-full max-w-[280px] rounded-[2.25rem] border-[6px] border-ink-900 bg-ink-900 shadow-soft-lg", className]}>
  <div class="relative overflow-hidden rounded-[1.75rem] bg-white">
    <div class="absolute left-1/2 top-2 z-10 h-5 w-24 -translate-x-1/2 rounded-full bg-ink-900"></div>
    <div class="min-h-[420px] pt-8">
      <slot />
    </div>
  </div>
</div>
