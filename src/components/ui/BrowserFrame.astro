---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label = "peek.peek-a-boo.app" } = Astro.props;
---

<div class:list={["overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-soft-lg", className]}>
  <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-danger/60"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-warning/60"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-success/60"></span>
    <span class="ml-3 truncate rounded-full bg-white px-3 py-1 text-[11px] font-medium text-ink-400">{label}</span>
  </div>
  <div class="bg-ink-950 p-5">
    <slot />
  </div>
</div>
