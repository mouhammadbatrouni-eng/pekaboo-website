---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "center", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "max-w-2xl",
    align === "center" ? "mx-auto text-center" : "text-left",
    className,
  ]}
>
  {eyebrow && (
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-brand-600">{eyebrow}</p>
  )}
  <h2 class="text-3xl font-extrabold text-ink-900 sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-relaxed text-ink-500">{description}</p>}
</div>
