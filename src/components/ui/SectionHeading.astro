---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  /** Use on dark surfaces. */
  tone?: "dark" | "light";
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  align = "center",
  tone = "dark",
  class: className = "",
} = Astro.props;

const titleClass = tone === "light" ? "text-white" : "text-ink-900";
const descriptionClass = tone === "light" ? "text-ink-300" : "text-ink-500";
const eyebrowClass = tone === "light" ? "text-brand-300" : "text-brand-700";
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left", className]}>
  {eyebrow && (
    <p class:list={["mb-3 text-xs font-bold uppercase tracking-[0.14em]", eyebrowClass]}>{eyebrow}</p>
  )}
  <h2 id={id} class:list={["text-3xl sm:text-4xl", titleClass]}>{title}</h2>
  {description && (
    <p class:list={["mt-4 text-lg leading-relaxed", descriptionClass]}>{description}</p>
  )}
</div>
