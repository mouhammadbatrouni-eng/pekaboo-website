---
import Logo from "../ui/Logo.astro";
import Button from "../ui/Button.astro";
import { resolveLink, isExternalLink } from "../../lib/content/resolveLink";
import { CTA } from "../../lib/content/site";
import type { SiteSettings } from "../../lib/content/types";

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const navLinks = site.navLinks ?? [];
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (!path.startsWith("/")) return false;
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<header class="sticky top-0 z-50 border-b border-ink-100/80 bg-[#fffaf5]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3.5 lg:px-8">
    <Logo />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {navLinks.map((link) => {
        const href = resolveLink(link);
        const active = isActive(href);
        return (
          <a
            href={href}
            target={isExternalLink(link) ? "_blank" : undefined}
            rel={isExternalLink(link) ? "noopener noreferrer" : undefined}
            aria-current={active ? "page" : undefined}
            class:list={[
              "rounded-full px-3.5 py-2 text-sm font-semibold transition-colors",
              active ? "bg-brand-50 text-brand-700" : "text-ink-600 hover:bg-white/70 hover:text-brand-700",
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={CTA.signIn.href}
        class="rounded-full px-3.5 py-2 text-sm font-semibold text-ink-600 transition-colors hover:text-brand-700"
      >
        {CTA.signIn.label}
      </a>
      {site.headerCta && (
        <Button href={resolveLink(site.headerCta.link)} variant={site.headerCta.style}>
          {site.headerCta.label}
        </Button>
      )}
    </div>

    <button
      id="mobile-nav-toggle"
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink-700 transition-colors hover:bg-white/70 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Open menu"
    >
      <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <div id="mobile-nav-panel" class="hidden border-t border-ink-100 bg-white lg:hidden">
    <nav class="flex flex-col gap-1 px-6 py-4" aria-label="Mobile">
      {navLinks.map((link) => {
        const href = resolveLink(link);
        return (
          <a
            href={href}
            target={isExternalLink(link) ? "_blank" : undefined}
            rel={isExternalLink(link) ? "noopener noreferrer" : undefined}
            aria-current={isActive(href) ? "page" : undefined}
            class:list={[
              "rounded-xl px-4 py-3 text-base font-semibold transition-colors",
              isActive(href) ? "bg-brand-50 text-brand-700" : "text-ink-700 hover:bg-ink-50",
            ]}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href={CTA.signIn.href}
        class="rounded-xl px-4 py-3 text-base font-semibold text-ink-700 transition-colors hover:bg-ink-50"
      >
        {CTA.signIn.label}
      </a>
    </nav>
    {site.headerCta && (
      <div class="border-t border-ink-100 px-6 py-4">
        <Button href={resolveLink(site.headerCta.link)} variant={site.headerCta.style} size="lg" class="w-full">
          {site.headerCta.label}
        </Button>
      </div>
    )}
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav-panel");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  function setOpen(open: boolean) {
    if (!toggle || !panel || !iconMenu || !iconClose) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    panel.classList.toggle("hidden", !open);
    iconMenu.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    // Stop the page scrolling behind an open full-width menu.
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });

  // Reset if the viewport grows past the mobile breakpoint while the menu is open.
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
