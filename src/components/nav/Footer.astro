---
import Logo from "../ui/Logo.astro";
import Container from "../ui/Container.astro";
import { resolveLink, isExternalLink } from "../../lib/content/resolveLink";
import { SITE } from "../../lib/content/site";
import { Mail, Phone, MapPin } from "@lucide/astro";
import type { SiteSettings } from "../../lib/content/types";

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-ink-950 text-ink-300">
  <Container class="py-16">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_2fr]">
      <div>
        <Logo tone="light" showTagline />
        {site.tagline && <p class="mt-5 max-w-xs leading-relaxed text-ink-400">{site.tagline}</p>}

        <address class="mt-6 space-y-2.5 not-italic text-sm">
          <a href={SITE.phoneHref} class="flex items-center gap-2.5 text-ink-300 transition-colors hover:text-white">
            <Phone size={15} class="shrink-0 text-brand-400" aria-hidden="true" />
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-2.5 text-ink-300 transition-colors hover:text-white">
            <Mail size={15} class="shrink-0 text-brand-400" aria-hidden="true" />
            {SITE.email}
          </a>
          <p class="flex items-start gap-2.5 text-ink-400">
            <MapPin size={15} class="mt-0.5 shrink-0 text-brand-400" aria-hidden="true" />
            {SITE.location}
          </p>
        </address>

        {site.socialLinks && site.socialLinks.length > 0 && (
          <ul class="mt-6 flex gap-3">
            {site.socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-full border border-white/10 px-3.5 py-1.5 text-xs font-semibold text-ink-300 transition-colors hover:border-brand-400 hover:text-brand-300"
                >
                  {social.platform}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {(site.footerColumns ?? []).map((column) => (
          <div>
            <h2 class="text-sm font-bold text-white">{column.heading}</h2>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={resolveLink(link)}
                    target={isExternalLink(link) ? "_blank" : undefined}
                    rel={isExternalLink(link) ? "noopener noreferrer" : undefined}
                    class="text-sm text-ink-400 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/8 pt-8 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p>Designed and developed by {SITE.parentCompany}.</p>
    </div>
  </Container>
</footer>
