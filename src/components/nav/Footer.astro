---
import Logo from "../ui/Logo.astro";
import Container from "../ui/Container.astro";
import { resolveLink, isExternalLink } from "../../lib/content/resolveLink";
import type { SiteSettings } from "../../lib/content/types";

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-ink-950 text-ink-300">
  <Container class="py-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo tone="light" />
        {site.tagline && <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-400">{site.tagline}</p>}
        {site.contactEmail && (
          <a href={`mailto:${site.contactEmail}`} class="mt-4 inline-block text-sm font-semibold text-brand-300 hover:text-brand-200">
            {site.contactEmail}
          </a>
        )}
        {site.socialLinks && site.socialLinks.length > 0 && (
          <div class="mt-6 flex gap-3">
            {site.socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-700 text-xs font-semibold text-ink-300 transition-colors hover:border-brand-400 hover:text-brand-300"
                aria-label={social.platform}
              >
                {social.platform.slice(0, 1)}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {(site.footerColumns ?? []).map((column) => (
          <div>
            <h3 class="text-sm font-semibold text-white">{column.heading}</h3>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={resolveLink(link)}
                    target={isExternalLink(link) ? "_blank" : undefined}
                    rel={isExternalLink(link) ? "noopener noreferrer" : undefined}
                    class="text-sm text-ink-400 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-ink-800 pt-8 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Peekaboo. All rights reserved.</p>
      <p>Made for nurseries who want their days back.</p>
    </div>
  </Container>
</footer>
