---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import SectionIntro from "./SectionIntro.astro";
import PhoneFrame from "../product/PhoneFrame.astro";
import { CURRICULA } from "../../lib/content/marketing";
import type { Dict, Lang } from "../../lib/i18n";

interface Props {
  t: Dict;
  lang: Lang;
}

const { t } = Astro.props;
---

<ScrollSection id="curriculum" label={t.nav.curriculum} surface="tint">
  <Container>
    <SectionIntro
      id="curriculum-heading"
      step="07"
      eyebrow={t.curriculum.eyebrow}
      title={t.curriculum.heading}
      description={t.curriculum.body}
    />

    <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_380px] lg:items-center lg:gap-16">
      <div>
        <ol class="grid gap-6 sm:grid-cols-2">
          {t.curriculum.steps.map((step, index) => (
            <li class="relative ps-11" data-reveal data-reveal-delay={index * 80}>
              <span
                class="absolute start-0 top-0 flex h-8 w-8 items-center justify-center rounded-full bg-surface text-sm font-bold text-brand-ink shadow-soft ring-1 ring-brand-100"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-ink">{step.step}</p>
              <p class="mt-1 font-bold text-body">{step.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
            </li>
          ))}
        </ol>

        <div class="mt-10 rounded-xl border border-line bg-surface p-6" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-subtle">
            {t.curriculum.frameworksLabel}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {CURRICULA.map((curriculum) => (
              <li
                class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-semibold text-body"
                title={curriculum.name}
              >
                <span dir="ltr">{curriculum.abbr}</span>
                <span class="sr-only"> — {curriculum.name}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-subtle">{t.curriculum.frameworksNote}</p>
        </div>
      </div>

      <div data-reveal data-reveal-delay="120">
        {/* Held well under the 380px column: a phone capture at full column
            width would tower over the seven steps beside it. */}
        <div class="flex justify-center">
          <PhoneFrame shot="assessmentReport" alt={t.product.shots.appAssessmentReport} class="max-w-[262px]" />
        </div>
        <p class="mt-4 text-center text-sm leading-relaxed text-subtle">{t.curriculum.plannerCaption}</p>
      </div>
    </div>
  </Container>
</ScrollSection>
