---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import SectionIntro from "./SectionIntro.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import { Check, ArrowRight, ArrowLeft } from "@lucide/astro";
import type { Dict } from "../../lib/i18n";

interface Props {
  t: Dict;
  rtl: boolean;
}

const { t, rtl } = Astro.props;

/** Icons and emphasis stay in code; only the words are translated. */
const META: Record<string, { icon: string; featured?: boolean }> = {
  "use-peekaboo": { icon: "attendance", featured: true },
  "customize-your-app": { icon: "communication" },
  "build-your-own": { icon: "curriculum" },
};

const Arrow = rtl ? ArrowLeft : ArrowRight;
---

<ScrollSection id="plans" label={t.nav.plans} surface="tint">
  <Container>
    <SectionIntro
      id="plans-heading"
      step="01"
      eyebrow={t.plans.eyebrow}
      title={t.plans.heading}
      description={t.plans.body}
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {t.plans.items.map((plan, index) => {
        const meta = META[plan.id] ?? { icon: "attendance" };
        return (
          <article
            data-reveal
            data-reveal-delay={index * 90}
            class:list={[
              "relative flex flex-col rounded-xl border bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg",
              meta.featured ? "border-brand-300 shadow-soft-lg" : "border-line shadow-soft hover:border-brand-200",
            ]}
          >
            {meta.featured && (
              <span class="absolute -top-3 start-7 rounded-full bg-[linear-gradient(180deg,#0e7fa8_0%,#0e77a1_100%)] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-white shadow-glow-brand">
                {t.plans.mostPopular}
              </span>
            )}

            <FeatureIcon icon={meta.icon} tone={meta.featured ? "brand" : "gold"} class="h-11 w-11" />
            <h3 class="mt-5 font-heading text-xl text-body">{plan.name}</h3>
            <p class="mt-3 leading-relaxed text-muted lg:min-h-[8.5rem]">{plan.description}</p>

            <p class="mt-6 text-xs font-bold uppercase tracking-[0.1em] text-subtle">{t.plans.bestFor}</p>
            <p class="mt-1 text-sm font-semibold text-body sm:min-h-[2.5rem]">{plan.bestFor}</p>

            <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
              {plan.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-body">
                  <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
                    <Check size={10} stroke-width={3.5} aria-hidden="true" />
                  </span>
                  {item}
                </li>
              ))}
            </ul>

            <a
              href="#contact"
              class="group mt-7 inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink transition-colors hover:text-brand-800"
            >
              {t.plans.talkToUs}
              <Arrow size={15} aria-hidden="true" />
            </a>
          </article>
        );
      })}
    </div>
  </Container>
</ScrollSection>
