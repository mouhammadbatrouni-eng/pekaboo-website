---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import Button from "../ui/Button.astro";
import ContactForm from "../sections/ContactForm.astro";
import { Mail, Phone, MapPin, MessageCircle } from "@lucide/astro";
import { SITE } from "../../lib/content/site";
---

{/* Final push before the form — the last moment to make the case. */}
<section class="pt-20 sm:pt-28">
  <Container>
    <div class="relative overflow-hidden rounded-2xl bg-ink-950 px-7 py-14 text-center sm:px-16" data-reveal>
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_80%_at_50%_0%,var(--color-brand-700),transparent)] opacity-70"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2 class="mx-auto max-w-2xl text-3xl text-white sm:text-4xl">
          Run your childcare center with less admin and more connection.
        </h2>
        <div class="mt-8">
          <Button href="#contact-form" size="lg">Get started with Peekaboo</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<ScrollSection id="contact" label="Contact">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 flex items-center justify-center gap-2.5 text-xs font-bold uppercase tracking-[0.14em] text-brand-700">
        <span class="rounded-full border border-ink-200 px-2 py-0.5 tabular-nums text-ink-400" aria-hidden="true">08</span>
        Contact
      </p>
      <h2 id="contact-heading" class="text-3xl sm:text-4xl">Ready to see Peekaboo in action?</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">
        Tell us about your center and we'll help you find the right Peekaboo setup.
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_320px] lg:gap-14">
      <div id="contact-form" class="scroll-mt-32">
        <ContactForm />
      </div>

      <aside class="lg:pt-2" data-reveal>
        <div class="rounded-2xl border border-ink-100 bg-white/80 p-6 shadow-soft">
          <h3 class="font-heading text-lg tracking-[-0.02em] text-ink-900">Or reach us directly</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a href={SITE.phoneHref} class="flex items-center gap-2.5 font-semibold text-ink-700 transition-colors hover:text-brand-700">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                  <Phone size={14} aria-hidden="true" />
                </span>
                {SITE.phone}
              </a>
            </li>
            <li>
              <a
                href={SITE.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 font-semibold text-ink-700 transition-colors hover:text-brand-700"
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mint-soft text-success">
                  <MessageCircle size={14} aria-hidden="true" />
                </span>
                WhatsApp
              </a>
            </li>
            <li>
              <a
                href={`mailto:${SITE.email}`}
                class="flex items-center gap-2.5 break-all font-semibold text-ink-700 transition-colors hover:text-brand-700"
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                  <Mail size={14} aria-hidden="true" />
                </span>
                {SITE.email}
              </a>
            </li>
            <li class="flex items-start gap-2.5 pt-1 text-ink-500">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                <MapPin size={14} aria-hidden="true" />
              </span>
              <span class="pt-1.5">{SITE.location}</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </Container>
</ScrollSection>
