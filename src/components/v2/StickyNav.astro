---
import Logo from "../ui/Logo.astro";
import Button from "../ui/Button.astro";
import { SECTIONS } from "./SECTIONS";
import { CTA } from "../../lib/content/site";
---

<header class="sticky top-0 z-50 border-b border-ink-100/70 bg-[#fffaf5]/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
    <a href="#top" class="shrink-0" aria-label="Peekaboo — back to top">
      <Logo />
    </a>

    <nav class="hidden xl:block" aria-label="Page sections">
      <ul class="flex items-center gap-0.5">
        {SECTIONS.map((section) => (
          <li>
            <a
              href={`#${section.id}`}
              data-nav-link={section.id}
              class="rounded-full px-3 py-2 text-[13px] font-semibold text-ink-600 transition-colors hover:bg-white hover:text-brand-700 aria-[current=true]:bg-brand-50 aria-[current=true]:text-brand-700"
            >
              {section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={CTA.signIn.href}
        class="hidden rounded-full px-3 py-2 text-sm font-semibold text-ink-600 transition-colors hover:text-brand-700 sm:block"
      >
        Sign in
      </a>
      <span class="hidden sm:block">
        <Button href="#contact">Get started</Button>
      </span>

      <button
        id="v2-menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink-700 transition-colors hover:bg-white xl:hidden"
        aria-expanded="false"
        aria-controls="v2-menu"
        aria-label="Open section menu"
      >
        <svg id="v2-icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="v2-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  {/* Reading progress. Purely decorative — the nav's active state carries the
      same information for assistive tech. */}
  <div class="h-0.5 w-full bg-ink-100" aria-hidden="true">
    <div id="v2-progress" class="h-full w-0 origin-left bg-brand-500 transition-[width] duration-150 ease-out"></div>
  </div>

  {/* Current-section label on small screens, where the full nav doesn't fit. */}
  <div class="border-t border-ink-100/70 bg-white/60 px-5 py-2 xl:hidden">
    <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-ink-400">
      <span class="sr-only">Currently viewing: </span>
      <span id="v2-current-label">Welcome</span>
    </p>
  </div>

  <div id="v2-menu" class="hidden border-t border-ink-100 bg-white xl:hidden">
    <nav class="grid grid-cols-2 gap-1 px-5 py-4" aria-label="Sections">
      {SECTIONS.map((section) => (
        <a
          href={`#${section.id}`}
          data-menu-link={section.id}
          class="rounded-xl px-4 py-3 text-sm font-semibold text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700 aria-[current=true]:bg-brand-50 aria-[current=true]:text-brand-700"
        >
          {section.label}
        </a>
      ))}
    </nav>
    <div class="border-t border-ink-100 px-5 py-4">
      <Button href="#contact" size="lg" class="w-full">Get started</Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("v2-menu-toggle");
  const menu = document.getElementById("v2-menu");
  const iconMenu = document.getElementById("v2-icon-menu");
  const iconClose = document.getElementById("v2-icon-close");
  const progress = document.getElementById("v2-progress");
  const currentLabel = document.getElementById("v2-current-label");

  function setMenuOpen(open: boolean) {
    if (!toggle || !menu || !iconMenu || !iconClose) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close section menu" : "Open section menu");
    menu.classList.toggle("hidden", !open);
    iconMenu.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => setMenuOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setMenuOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  // --- Scroll spy -----------------------------------------------------------
  // Tracks which section occupies the reading area, rather than whichever
  // happens to be intersecting — so short sections don't steal the highlight
  // from a long one the reader is still inside.
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-link]"));
  const menuLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-menu-link]"));

  function setActive(id: string | null, label: string) {
    for (const link of [...navLinks, ...menuLinks]) {
      const key = link.dataset.navLink ?? link.dataset.menuLink;
      if (key === id) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
    if (currentLabel) currentLabel.textContent = label;
  }

  function update() {
    // Progress through the whole document.
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
    if (progress) progress.style.width = `${ratio * 100}%`;

    // Active section: the last one whose top has passed the reading line.
    const line = window.scrollY + window.innerHeight * 0.35;
    let active: HTMLElement | null = null;
    for (const section of sections) {
      if (section.offsetTop <= line) active = section;
    }
    setActive(active?.dataset.section ?? null, active?.dataset.sectionLabel ?? "Welcome");
  }

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  update();
</script>
