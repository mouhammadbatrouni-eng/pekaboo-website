---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import SectionIntro from "./SectionIntro.astro";
import { SITE } from "../../lib/content/site";

const AUDIENCES = [
  "Nurseries",
  "Preschools",
  "Daycare centers",
  "Kindergartens",
  "Montessori settings",
  "Nursery groups",
];
---

<ScrollSection id="about" label="About" surface="tint">
  <Container>
    <SectionIntro
      id="about-heading"
      step="05"
      eyebrow="About"
      title="Built around the way early-years teams actually work"
      description="Peekaboo brings administration, educators, families, children's development, payments and communication together in one connected environment — and stays configurable, because no two settings run the same way."
    />

    <div class="mx-auto mt-12 max-w-3xl" data-reveal>
      <p class="text-center text-xs font-bold uppercase tracking-[0.12em] text-subtle">
        Used by settings like
      </p>
      <ul class="mt-5 flex flex-wrap justify-center gap-2.5">
        {AUDIENCES.map((audience) => (
          <li class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold text-body shadow-soft">
            {audience}
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center leading-relaxed text-muted">
        Whether you run a single room or a group of centers, the same platform adapts — classes, age
        groups, curriculum frameworks and fee structures are all yours to define.
      </p>
      <p class="mt-6 text-center text-sm text-subtle">
        Peekaboo is built and supported by {SITE.parentCompany}, based in {SITE.location}.
      </p>
    </div>
  </Container>
</ScrollSection>
