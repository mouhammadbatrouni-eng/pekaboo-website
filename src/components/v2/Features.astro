---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import SectionIntro from "./SectionIntro.astro";
import FeatureIcon from "../ui/FeatureIcon.astro";
import PortalScreen from "../product/PortalScreen.astro";
import PhoneShell from "../product/PhoneShell.astro";
import ParentAppBody from "../product/ParentAppBody.astro";
import { FEATURE_GROUPS } from "../../lib/content/featureGroups";
---

<ScrollSection id="features" label="Features" surface="tint">
  <Container>
    <SectionIntro
      id="features-heading"
      step="03"
      eyebrow="Features"
      title="What's inside Peekaboo"
      description="Grouped the way you'd look for them. Each group is paired with the part of the product it lives in."
    />

    <div class="mt-16 space-y-20 lg:space-y-28">
      {FEATURE_GROUPS.map((group, index) => (
        <div
          class:list={[
            "grid gap-10 lg:grid-cols-[1fr_340px] lg:items-start lg:gap-14",
            index % 2 === 1 && "lg:grid-cols-[340px_1fr]",
          ]}
        >
          <div class:list={[index % 2 === 1 && "lg:order-2"]}>
            <div data-reveal>
              <h3 class="font-heading text-2xl tracking-[-0.03em] text-ink-900">{group.title}</h3>
              <p class="mt-2 max-w-xl leading-relaxed text-ink-500">{group.summary}</p>
            </div>

            <ul class="mt-8 grid gap-4 sm:grid-cols-2">
              {group.items.map((item, i) => (
                <li
                  data-reveal
                  data-reveal-delay={i * 60}
                  class="rounded-xl border border-ink-100 bg-white p-5 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft-lg"
                >
                  <FeatureIcon icon={item.icon} class="h-9 w-9" />
                  <h4 class="mt-3.5 font-bold text-ink-900">{item.name}</h4>
                  <p class="mt-1 text-sm leading-relaxed text-ink-500">{item.description}</p>
                </li>
              ))}
            </ul>
          </div>

          {/* The product itself, kept alongside each group so the section never
              becomes a wall of cards. Sticky on desktop only. */}
          <figure class:list={["lg:sticky lg:top-32", index % 2 === 1 && "lg:order-1"]} data-reveal>
            {group.visual.kind === "portal" ? (
              <PortalScreen screen={group.visual.screen} />
            ) : (
              <div class="flex justify-center">
                <PhoneShell class="max-w-[250px]">
                  <ParentAppBody screen={group.visual.screen} />
                </PhoneShell>
              </div>
            )}
            <figcaption class="mt-4 text-center text-sm leading-relaxed text-ink-400">
              {group.caption}
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </Container>
</ScrollSection>
