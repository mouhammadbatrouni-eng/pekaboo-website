---
import { urlForImage } from "../../lib/sanity/image";
import type { Post } from "../../lib/content/types";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const coverUrl = urlForImage(post.coverImage)?.width(640).height(400).url();
const date = new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<a href={`/blog/${post.slug}`} class="group block overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg hover:border-brand-200">
  <div class="aspect-[16/10] overflow-hidden bg-ink-100">
    {coverUrl && (
      <img
        src={coverUrl}
        alt={post.coverImage.alt || ""}
        width="640"
        height="400"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
  </div>
  <div class="p-6">
    {post.category && (
      <span class="text-xs font-bold uppercase tracking-wide text-brand-600">{post.category.title}</span>
    )}
    <h3 class="mt-2 text-lg font-bold text-ink-900 group-hover:text-brand-700">{post.title}</h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-500">{post.excerpt}</p>
    <div class="mt-4 flex items-center gap-2 text-xs text-ink-400">
      <span>{post.author.name}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.publishedAt}>{date}</time>
    </div>
  </div>
</a>
