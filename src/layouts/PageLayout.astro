---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/nav/Header.astro";
import Footer from "../components/nav/Footer.astro";
import { getSiteSettings } from "../lib/sanity/queries";
import { resolveSeo } from "../lib/seo";
import type { Faq, Seo } from "../lib/content/types";

interface Props {
  title: string;
  seo?: Seo;
  includeOrgSchema?: boolean;
  faqs?: Faq[];
}

const { title, seo: pageSeo, includeOrgSchema = false, faqs } = Astro.props;

const site = await getSiteSettings();
const resolvedSeo = resolveSeo(title, pageSeo, site);
---

<BaseLayout seo={resolvedSeo} includeOrgSchema={includeOrgSchema} faqs={faqs}>
  <Header site={site} />
  <main id="main-content">
    <slot />
  </main>
  <Footer site={site} />
</BaseLayout>
